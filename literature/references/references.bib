	month = aug,
	year = {2021},
	keywords = {Aqueous multivalent polyelectrolyte systems, Aqueous polyelectrolyte systems, Manning’s limiting law, Polyelectrolyte Nonrandom Two-Liquid model},
	pages = {116237},
	file = {ScienceDirect Full Text PDF:/Users/pierrewalker/Zotero/storage/4CJKGHWL/Li et al. - 2021 - Modeling aqueous multivalent polyelectrolytes systems with polyelectrolyte NRTL model.pdf:application/pdf;ScienceDirect Snapshot:/Users/pierrewalker/Zotero/storage/HXURK9DR/S0167732221009636.html:text/html},
}

