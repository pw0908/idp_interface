@article{changSequenceEntropybasedControl2017,
	title = {Sequence and entropy-based control of complex coacervates},
	volume = {8},
	copyright = {2017 The Author(s)},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-017-01249-1},
	doi = {10.1038/s41467-017-01249-1},
	abstract = {Biomacromolecules rely on the precise placement of monomers to encode information for structure, function, and physiology. Efforts to emulate this complexity via the synthetic control of chemical sequence in polymers are finding success; however, there is little understanding of how to translate monomer sequence to physical material properties. Here we establish design rules for implementing this sequence-control in materials known as complex coacervates. These materials are formed by the associative phase separation of oppositely charged polyelectrolytes into polyelectrolyte dense (coacervate) and polyelectrolyte dilute (supernatant) phases. We demonstrate that patterns of charges can profoundly affect the charge–charge associations that drive this process. Furthermore, we establish the physical origin of this pattern-dependent interaction: there is a nuanced combination of structural changes in the dense coacervate phase and a 1D confinement of counterions due to patterns along polymers in the supernatant phase.},
	language = {en},
	number = {1},
	urldate = {2026-07-01},
	journal = {Nat. Commun.},
	publisher = {Nature Publishing Group},
	author = {Chang, Li-Wei and Lytle, Tyler K. and Radhakrishna, Mithun and Madinya, Jason J. and Vélez, Jon and Sing, Charles E. and Perry, Sarah L.},
	month = nov,
	year = {2017},
	keywords = {Polymers, Self-assembly, Bioinspired materials, Chemical engineering},
	pages = {1273},
