	pages = {117174},
	file = {Tsanas et al. - 2022 - Calculation of phase and chemical equilibrium for .pdf:/Users/pierrewalker/Zotero/storage/I8DMH6XG/Tsanas et al. - 2022 - Calculation of phase and chemical equilibrium for .pdf:application/pdf},
}

