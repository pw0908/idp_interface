	month = oct,
	year = {2024},
	keywords = {Cheminformatics, Biophysical chemistry, Data publication and archiving, Quantum mechanics, Scientific data},
	pages = {1164},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/EDHF3ZWX/Takaya et al. - 2024 - Quantum chemical calculation dataset for representative protein folds by the fragment molecular orbi.pdf:application/pdf},
}

