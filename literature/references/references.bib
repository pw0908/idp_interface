	doi = {10.1021/acsmacrolett.8b00484},
	abstract = {In recent experiments, the “local pH” near polyelectrolyte chains was determined from the shift in the effective acidity constant of fluorescent pH indicators attached to the macromolecules. This indirect determination raises the question if the analyzed quantity was indeed the “local pH” and what this term actually means. In this study, we combined experiments and simulations to demonstrate that the shift in ionization constant is slightly lower than the difference between the pH and the “local pH”. This offset is caused by correlations between fluctuations in chain conformation, small-ion distribution, and fluorophore ionization.},
	number = {10},
	urldate = {2025-04-29},
	journal = {ACS Macro Lett.},
	author = {Murmiliuk, Anastasiia and Košovan, Peter and Janata, Miroslav and Procházka, Karel and Uhlík, Filip and Štěpánek, Miroslav},
	month = oct,
