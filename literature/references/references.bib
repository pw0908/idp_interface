@article{wangIonTransportThermally2023,
	title = {Ion transport in thermally responsive pectin film},
	volume = {123},
	issn = {0003-6951},
	url = {https://doi.org/10.1063/5.0142020},
	doi = {10.1063/5.0142020},
	abstract = {The ionic conductivity of CaCl2-crosslinked pectin was found to exhibit a record-high temperature response, suggesting its potential applications in wearable devices and infrared sensors [R. Di Giacomo et al., Sci. Rob. 2, eaai9251 (2017)]. However, little was known about its ion conduction mechanisms and the origin of its high-temperature sensitivity. In this study, we perform controlled experiments and identify calcium ions as the dominant current carriers. By analyzing infrared spectra at different temperatures, we find that the temperature response is due to changes in ion mobility, rather than variations in ion number density. We compare measurements and modeling results of nine different multivalent ions and find a positive correlation between their temperature responses and their binding energy to pectin. While these findings are fundamental in nature, they provide relevant guidance for the future design of temperature-sensitive polymers and other materials for organic electronics.},
	number = {2},
	urldate = {2024-02-24},
	journal = {Appl. Phys. Lett.},
	author = {Wang, Linghui and Kim, Tae Hyun and Costanza, Vincenzo and Higdon, Nicholas J. and Daraio, Chiara},
	month = jul,
	year = {2023},
	pages = {021903},
	file = {Snapshot:/Users/pierrewalker/Zotero/storage/7TCZUHWL/Ion-transport-in-thermally-responsive-pectin-film.html:text/html},
}

@article{jensenGraphbasedGeneticAlgorithm2019,
	title = {A graph-based genetic algorithm and generative model/{Monte} {Carlo} tree search for the exploration of chemical space},
	volume = {10},
	issn = {2041-6539},
	url = {https://pubs.rsc.org/en/content/articlelanding/2019/sc/c8sc05372c},
	doi = {10.1039/C8SC05372C},
	abstract = {This paper presents a comparison of a graph-based genetic algorithm (GB-GA) and machine learning (ML) results for the optimization of log P values with a constraint for synthetic accessibility and shows that the GA is as good as or better than the ML approaches for this particular property. The molecules found by the GB-GA bear little resemblance to the molecules used to construct the initial mating pool, indicating that the GB-GA approach can traverse a relatively large distance in chemical space using relatively few (50) generations. The paper also introduces a new non-ML graph-based generative model (GB-GM) that can be parameterized using very small data sets and combined with a Monte Carlo tree search (MCTS) algorithm. The results are comparable to previously published results (Sci. Technol. Adv. Mater., 2017, 18, 972–976) using a recurrent neural network (RNN) generative model, and the GB-GM-based method is several orders of magnitude faster. The MCTS results seem more dependent on the composition of the training set than the GA approach for this particular property. Our results suggest that the performance of new ML-based generative models should be compared to that of more traditional, and often simpler, approaches such a GA.},
	number = {12},
	urldate = {2024-02-24},
	journal = {Chem. Sci.},
	author = {Jensen, Jan H.},
	month = mar,
	year = {2019},
	pages = {3567--3572},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/NJMXVZHL/Jensen - 2019 - A graph-based genetic algorithm and generative mod.pdf:application/pdf;Supplementary Information PDF:/Users/pierrewalker/Zotero/storage/UANFUVMY/Jensen - 2019 - A graph-based genetic algorithm and generative mod.pdf:application/pdf},
}

@article{rozmusModelingStrongElectrolytes2013,
	title = {Modeling of {Strong} {Electrolytes} with {ePPC}-{SAFT} up to {High} {Temperatures}},
	volume = {52},
	issn = {0888-5885},
	url = {https://doi.org/10.1021/ie303527j},
	doi = {10.1021/ie303527j},
	abstract = {An extension of the PPC-SAFT equation of state to treat strong electrolyte aqueous solutions is presented. It is capable of describing the behavior of such systems up to 473 K with a good precision and without requiring temperature-dependent model parameters. Long-range Coulombic interactions are taken into account using the mean spherical approximation (MSA) for a primitive model of the electrolyte solution, and the effect of solvation is described using short-range ion–water interactions mediated through association sites. Pairing between anions and cations is also treated through site–site interactions. A Born term is added to describe the change of dielectric constant resulting from solvation. A single ion-specific, temperature-independent model parameters are used, for 20 alkali-halide aqueous solutions. The Pauling ionic diameters are used for all terms (hard sphere, MSA, and Born). The dispersion energy of the ions is considered negligible. In the resulting ePPC-SAFT model, only the water–ion association energy is considered as an adjustable parameter. The results show coherent energy density behavior with respect to ionic size. The approach allows the calculation of the mean ionic activity coefficient, density, or vapor pressure of the aqueous solutions over a wide range of temperatures and molalities (298–573 K and 0–6 m). Moreover, salting out of carbon dioxide and methane in saline water can also be predicted accurately. A discussion of the changes in ion hydration at different salinity is also presented taking advantage of the model proposed that explicitly includes ion–water site–site interactions.},
	number = {29},
	urldate = {2024-03-13},
	journal = {Ind. Eng. Chem. Res.},
	author = {Rozmus, Justyna and de Hemptinne, Jean-Charles and Galindo, Amparo and Dufal, Simon and Mougin, Pascal},
	month = jul,
	year = {2013},
	pages = {9979--9994},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/EVRI6Y5E/Rozmus et al. - 2013 - Modeling of Strong Electrolytes with ePPC-SAFT up .pdf:application/pdf},
}

@article{guoTunableMechanicalProperties2024,
	title = {Tunable {Mechanical} {Properties} in {Microphase}-{Separated} {Thermoplastic} {Elastomers} via {Metal}–{Ligand} {Coordination}},
	volume = {57},
	issn = {0024-9297},
	url = {https://doi.org/10.1021/acs.macromol.4c00178},
	doi = {10.1021/acs.macromol.4c00178},
	abstract = {Inspired by the structure of tough biological tissues of mussel byssus cuticles, the incorporation of weak reversible bonds in multiphase thermoplastic elastomers (TPEs) has shown promise for enhancing mechanical performance. However, the effects of the reversible bond distribution on the mechanical properties of TPEs warrant further investigation. Here, a novel design strategy was proposed and demonstrated to improve the toughness of TPEs by introducing metal–ligand coordination bonds in all phases of a TPE with a microphase-separated structure. An ABA-type triblock copolymer was designed, with varying ligand density in the A and B blocks. Based on the immiscibility of two blocks, the A blocks aggregated to form hard phases with a high density of metal–ligand bonds, dispersed within the soft matrix phase consisting of the B block and spare metal–ligand bonds. Metal–ligand coordination bonds in the hard and soft phases, as well as at their interface, played crucial roles in the dynamic mechanical properties of the TPE. Furthermore, the mechanical properties of this TPE could be easily and extensively adjusted by manipulating the parameters associated with the metal–ligand coordination bonds. Our design strategy provides insights into the relationship between metal–ligand coordination bonds and multiphase structures and their combined effects on the bulk mechanical properties of TPEs.},
	number = {5},
	urldate = {2024-03-13},
	journal = {Macromolecules},
	author = {Guo, Xiangyuan and Nakagawa, Shintaro and Yoshie, Naoko},
	month = mar,
	year = {2024},
	pages = {2351--2362},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/LZPJ5IXY/Guo et al. - 2024 - Tunable Mechanical Properties in Microphase-Separa.pdf:application/pdf},
}

@article{duvediDesigningEnvironmentallySafe1996,
