	url = {https://doi.org/10.1021/acs.iecr.0c01734},
	doi = {10.1021/acs.iecr.0c01734},
	abstract = {In the last two centuries, equations of state (EoSs) have become a key tool for the correlation and prediction of thermodynamic properties of fluids. They not only can be applied to pure substances as well as to mixtures but also constitute the heart of commercially available computer-aided-process-design software. In the last 20 years, thousands of publications have been devoted to the development of sophisticated models or to the improvement of already existing EoSs. Chemical engineering thermodynamics is thus a field under steady development, and to assess the accuracy of a thermodynamic model or to cross-compare two models, it is necessary to confront model predictions with experimental data. In this context, the importance of a reliable free-to-access benchmark database is pivotal and becomes absolutely necessary. The goal of this paper is thus to present a database, specifically designed to assess the accuracy of a thermodynamic model or cross-compare models, to explain how it was developed and to enlighten how to use it. A total of 200 nonelectrolytic binary systems have been selected and divided into nine groups according to the associating character of the components, i.e., their ability to be involved in a hydrogen bond (the nature and strength of the association phenomena are indeed considered a measure of the complexity to model the thermodynamic properties of mixtures). The methodology for assessing the performance of a given model is then described. As an illustration, the Peng–Robinson EoS with classical van der Waals mixing rules and a temperature-dependent binary interaction parameter (kij) have been used to correlate the numerous data included in the proposed database, and its performance has been assessed following the proposed methodology.},
	number = {33},
	urldate = {2025-12-04},
	journal = {Ind. Eng. Chem. Res.},
	publisher = {American Chemical Society},
	author = {Jaubert, Jean-Noël and Le Guennec, Yohann and Piña-Martinez, Andrés and Ramirez-Velez, Nicolas and Lasala, Silvia and Schmid, Bastian and Nikolaidis, Ilias K. and Economou, Ioannis G. and Privat, Romain},
	month = aug,
	year = {2020},
	pages = {14981--15027},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/ZBW9K5Q7/Jaubert et al. - 2020 - Benchmark Database Containing Binary-System-High-Quality-Certified Data for Cross-Comparing Thermody.pdf:application/pdf},
}

@article{liPCSAFTTypeEquationsState2025,
	title = {{PC}-{SAFT}-{Type} {Equations} of {State} {Revisited}: {Quantifying} the {Value} of {Base} {Model} {Adjustments} through {Universal} {Criteria} {Benchmarks}},
	volume = {64},
	issn = {0888-5885},
	shorttitle = {{PC}-{SAFT}-{Type} {Equations} of {State} {Revisited}},
	url = {https://doi.org/10.1021/acs.iecr.5c01189},
	doi = {10.1021/acs.iecr.5c01189},
	abstract = {The statistical associating fluid theory (SAFT) equations of state have been extensively applied in diverse forms across various industrial fields. Within this investigation, based on a benchmark database encompassing binary systems with diverse association characteristics, perturbed-chain SAFT (PC-SAFT), perturbed-chain polar SAFT (PCP-SAFT), and simplified perturbed-chain SAFT (sPC-SAFT) were systematically incorporated into the same phase equilibrium evaluation framework for a fair comparison. Furthermore, some ternary systems are also considered as additional supplements to compare the performance of the models in predicting multicomponent mixtures. The comparison results show that PCP-SAFT and sPC-SAFT exhibit overall better performance than the original version, yet the latter continues to hold its absolute superiority in some mixtures with specific characteristics. Additionally, it is also demonstrated that any modification to the parent model is challenging to balance across various domains, and the resulting trade-offs appear to be an inherent limitation of SAFT variant development.},
	number = {34},
	urldate = {2025-12-04},
	journal = {Ind. Eng. Chem. Res.},
	publisher = {American Chemical Society},
	author = {Li, Kaiqi and Ye, Zhencheng and Liang, Xiaodong},
	month = aug,
	year = {2025},
	pages = {16873--16888},
}

@article{cummingsDielectricConstantDipolar1986,
	title = {Dielectric constant of dipolar hard sphere mixtures},
	volume = {85},
	issn = {0021-9606},
	url = {https://doi.org/10.1063/1.451447},
	doi = {10.1063/1.451447},
	abstract = {The dielectric constant of dipolar hard sphere mixtures is calculated from the analytic solution of the mean spherical approximation (MSA) and using Monte Carlo simulation. The MSA is solved using the factorization technique pioneered by Wertheim and Baxter and extended to nonspherical interactions by Blum. The simulations are performed using the Ewald technique to take into account the long‐ranged dipolar interactions. The simulation results are compared to those obtained from the MSA as well as a modified MSA and a continuum theory due to Looyenga.},
	number = {11},
	urldate = {2025-12-04},
	journal = {J. Chem. Phys.},
	author = {Cummings, P. T. and Blum, L.},
	month = dec,
