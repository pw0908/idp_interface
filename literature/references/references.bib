	issn = {0743-7463},
	shorttitle = {Proteins and {Polyampholytes} {Interacting} with {Polyelectrolyte} {Brushes} and {Microgels}},
	url = {https://doi.org/10.1021/acs.langmuir.0c02837},
	doi = {10.1021/acs.langmuir.0c02837},
	abstract = {Weak polyampholytes and globular proteins among them can be efficiently absorbed from solutions by polyelectrolyte brushes or microgels even if the net charge of the polyampholyte is of the same sign as that of the brush/microgel. We use a mean-field approach for calculating the free energy of insertion of a probe polyampholyte molecule into a polyelectrolyte brush/microgel. We anticipate that the insertion of the polyampholyte into similarly charged brush/microgel may be thermodynamically favorable due to the gain in the cumulative re-ionization free energy of the pH-sensitive acidic and basic residues. Importantly, we demonstrate that the polyampholyte (protein) charge sign inversion upon transfer from the bulk of the solution to the brush/microgel does not provide sufficient conditions to assure negative re-ionization free energy balance. Thus (in the absence of other driving or stopping mechanisms), charge sign inversion does not necessarily provoke spontaneous absorption of the polyampholyte into the brush/microgel.},
	number = {9},
	urldate = {2023-05-11},
	journal = {Langmuir},
	author = {Laktionov, Mikhail Y. and Zhulina, Ekaterina B. and Borisov, Oleg V.},
	month = mar,
	year = {2021},
	pages = {2865--2873},
	file = {ACS Full Text Snapshot:/Users/pierrewalker/Zotero/storage/THIJXEKI/acs.langmuir.html:text/html;Full Text PDF:/Users/pierrewalker/Zotero/storage/FL9BZPRI/Laktionov et al. - 2021 - Proteins and Polyampholytes Interacting with Polye.pdf:application/pdf},
}

@article{ryzhkovCouplingPHRegulatedMultilayers2019,
	title = {Coupling {pH}-{Regulated} {Multilayers} with {Inorganic} {Surfaces} for {Bionic} {Devices} and {Infochemistry}},
	volume = {35},
	issn = {0743-7463},
	url = {https://doi.org/10.1021/acs.langmuir.9b00633},
	doi = {10.1021/acs.langmuir.9b00633},
	abstract = {This article summarizes more than 10 years of cooperation with Prof. Helmuth Möhwald. Here we describe how the research moved from light-regulated feedback sustainable systems and control biodevices to the current focus on infochemistry in aqueous solution. An important advanced characteristic of such materials and devices is the pH concentration gradient in aqueous solution. A major part of the article focuses on the use of localized illumination for proton generation as a reliable, minimal-reagent-consuming, stable light-promoted proton pump. The in situ scanning vibration electrode technique (SVET) and scanning ion-selective electrode technique (SIET) are efficient for the spatiotemporal evolution of ions on the surface. pH-sensitive polyelectrolyte (PEs) multilayers with different PE architectures are composed with a feedback loop for bionic devices. We show here that pH-regulated PE multilayers can change their properties—film thickness and stiffness, permeability, hydrophilicity, and/or fluorescence—in response to light or electrochemical or biological processes instead of classical acid/base titration.},
	number = {26},
	urldate = {2023-05-11},
	journal = {Langmuir},
	author = {Ryzhkov, Nikolay V. and Andreeva, Daria V. and Skorb, Ekaterina V.},
	month = jul,
	year = {2019},
	pages = {8543--8556},
	file = {ACS Full Text Snapshot:/Users/pierrewalker/Zotero/storage/GK8CA7EN/acs.langmuir.html:text/html;Full Text PDF:/Users/pierrewalker/Zotero/storage/NFJVDXNF/Ryzhkov et al. - 2019 - Coupling pH-Regulated Multilayers with Inorganic S.pdf:application/pdf},
}

@article{zhongReviewElectrolyteMaterials2015,
	title = {A review of electrolyte materials and compositions for electrochemical supercapacitors},
	volume = {44},
	issn = {1460-4744},
	url = {https://pubs.rsc.org/en/content/articlelanding/2015/cs/c5cs00303b},
	doi = {10.1039/C5CS00303B},
	abstract = {Electrolytes have been identified as some of the most influential components in the performance of electrochemical supercapacitors (ESs), which include: electrical double-layer capacitors, pseudocapacitors and hybrid supercapacitors. This paper reviews recent progress in the research and development of ES electrolytes. The electrolytes are classified into several categories, including: aqueous, organic, ionic liquids, solid-state or quasi-solid-state, as well as redox-active electrolytes. Effects of electrolyte properties on ES performance are discussed in detail. The principles and methods of designing and optimizing electrolytes for ES performance and application are highlighted through a comprehensive analysis of the literature. Interaction among the electrolytes, electro-active materials and inactive components (current collectors, binders, and separators) is discussed. The challenges in producing high-performing electrolytes are analyzed. Several possible research directions to overcome these challenges are proposed for future efforts, with the main aim of improving ESs' energy density without sacrificing existing advantages (e.g., a high power density and a long cycle-life) (507 references).},
	number = {21},
	urldate = {2023-05-11},
	journal = {Chem. Soc. Rev.},
	author = {Zhong, Cheng and Deng, Yida and Hu, Wenbin and Qiao, Jinli and Zhang, Lei and Zhang, Jiujun},
	month = oct,
	year = {2015},
	pages = {7484--7539},
}

@article{achaziUnderstandingInteractionPolyelectrolyte2021,
	title = {Understanding the {Interaction} of {Polyelectrolyte} {Architectures} with {Proteins} and {Biosystems}},
	volume = {60},
	issn = {1521-3773},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/anie.202006457},
	doi = {10.1002/anie.202006457},
	abstract = {The counterions neutralizing the charges on polyelectrolytes such as DNA or heparin may dissociate in water and greatly influence the interaction of such polyelectrolytes with biomolecules, particularly proteins. In this Review we give an overview of studies on the interaction of proteins with polyelectrolytes and how this knowledge can be used for medical applications. Counterion release was identified as the main driving force for the binding of proteins to polyelectrolytes: Patches of positive charge become multivalent counterions of the polyelectrolyte and lead to the release of counterions from the polyelectrolyte and a concomitant increase in entropy. This is shown from investigations on the interaction of proteins with natural and synthetic polyelectrolytes. Special emphasis is paid to sulfated dendritic polyglycerols (dPGS). The Review demonstrates that we are moving to a better understanding of charge–charge interactions in systems of biological relevance. Research along these lines will aid and promote the design of synthetic polyelectrolytes for medical applications.},
	number = {8},
	urldate = {2023-05-11},
	journal = {Angew. Chem., Int. Ed.},
	author = {Achazi, Katharina and Haag, Rainer and Ballauff, Matthias and Dernedde, Jens and Kizhakkedathu, Jayachandran N. and Maysinger, Dusica and Multhaup, Gerd},
	year = {2021},
	keywords = {polyelectrolytes, complementary binding, counterion release, heparin, inflammation},
	pages = {3882--3904},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/BZTLC4DU/Achazi et al. - 2021 - Understanding the Interaction of Polyelectrolyte A.pdf:application/pdf;Snapshot:/Users/pierrewalker/Zotero/storage/UUIBQWHH/anie.html:text/html},
}

