	keywords = {Capsules, Encapsulation, Enzymes, LbL, Nanomedicine, Stimuli, Theranostics},
	pages = {730--747},
	file = {ScienceDirect Full Text PDF:/Users/pierrewalker/Zotero/storage/B3RTHXHI/Delcea et al. - 2011 - Stimuli-responsive LbL capsules and nanoshells for.pdf:application/pdf;ScienceDirect Snapshot:/Users/pierrewalker/Zotero/storage/G6QU8X76/S0169409X11000615.html:text/html},
}

