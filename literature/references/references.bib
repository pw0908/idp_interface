@article{xieMultimodalThermodynamicDataset,
	title = {Multimodal thermodynamic dataset for polymer solution model training},
	volume = {2026},
	url = {https://chemrxiv.org/doi/full/10.26434/chemrxiv.15007870/v1},
	doi = {10.26434/chemrxiv.15007870/v1},
	abstract = {Polymer solutions are thermodynamically complex mixtures owing to local correlations from chain connectivity and size asymmetry between polymer and solvent. A consequence of polymer solution complexity is a richness in solution phase behavior which gives rise to industrially and scientifically relevant material properties, the prediction of which is a long-standing goal of polymer science. The Flory-Huggins χ-parameter remains the most widely-used method for quantifying such interactions despite being a fitted parameter specific to the Flory-Huggins solution model. This approach contrasts with small molecule thermodynamics which generally use model-free thermodynamic interaction data such as the activity coefficients. The lack of an accessible database of model-free thermodynamic interaction properties for polymer solutions is one obstacle hindering the development of more advanced thermodynamic models for polymer solutions. In this work, a database of over 7,000 model-free thermodynamic properties obtained across the composition range with a variety of experimental techniques was compiled. These points represent over 1,000 unique polymer-solvent combinations of over 50 polymers and 170 solvents. An additional ≈10,000 points of liquid-liquid equilibrium (LLE) data was compiled for over 180 unique polymer-solvent pairs. To make the dataset widely available to the community and to encourage community contributions, all data was uploaded into the CRIPT data ecosystem.},
	number = {0825},
	urldate = {2026-08-26},
	journal = {ChemRxiv},
	publisher = {ChemRxiv},
	author = {Xie, Oliver and Osmani, Ardiana and Leão, Bruno S. and Audus, Debra J. and Ethier, Jeffrey G. and Olsen, Bradley D.},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/YBA8ESDZ/Xie et al. - Multimodal thermodynamic dataset for polymer solution model training.pdf:application/pdf},
}

@article{menjogeInfluenceWaterDiffusion2009,
	title = {Influence of {Water} on {Diffusion} in {Imidazolium}-{Based} {Ionic} {Liquids}: {A} {Pulsed} {Field} {Gradient} {NMR} study},
	volume = {113},
	issn = {1520-6106},
	shorttitle = {Influence of {Water} on {Diffusion} in {Imidazolium}-{Based} {Ionic} {Liquids}},
	url = {https://doi.org/10.1021/jp900902n},
	doi = {10.1021/jp900902n},
	abstract = {In this work, we applied a novel pulsed field gradient (PFG) NMR option, which combines advantages of high-field (17.6 T) NMR and high magnetic field gradients (up to 30 T/m), to study diffusion of anions, cations and water in two 1-ethyl-3-methylimidazolium-based ionic liquids. Application of high field allows for an easy recording of an NMR signal from small amounts of water added to the ionic liquids. Using high gradients is advantageous because under conditions of such gradients any susceptibility-induced inhomogeneities in the local magnetic field are expected to be negligibly small in comparison with the applied gradients. PFG NMR studies have been performed in a broad range of temperatures and for different diffusion times. The effect of water addition on the diffusion behavior of the anions and cations is discussed in the context of the presence of polar and nonpolar domains in the ionic liquids. A partial screening of the electrostatic interaction between the cations and anions in the polar domains by water is believed to be responsible for the following changes in the diffusion behavior, which were observed experimentally: (i) increase in the ion diffusivities with increasing water concentration, and (ii) decrease in the difference between the diffusion coefficient of the cation and that of the anion as water concentration increases.},
	number = {18},
	urldate = {2026-08-26},
	journal = {J. Phys. Chem. B},
	author = {Menjoge, Amrish and Dixon, JaNeille and Brennecke, Joan F. and Maginn, Edward J. and Vasenkov, Sergey},
	month = apr,
	year = {2009},
	pages = {6353--6359},
	file = {Snapshot:/Users/pierrewalker/Zotero/storage/BM4FIEDQ/jp900902n.html:text/html},
}

