}

@article{inguvaMechanisticModelingLipid2025,
	title = {Mechanistic modeling of lipid nanoparticle formation for the delivery of nucleic acid therapeutics},
	volume = {84},
	copyright = {All rights reserved},
	issn = {0734-9750},
	url = {https://www.sciencedirect.com/science/article/pii/S0734975025001296},
	doi = {10.1016/j.biotechadv.2025.108643},
	abstract = {Nucleic acids such as mRNA have emerged as a promising therapeutic modality with the capability of addressing a wide range of diseases. Lipid nanoparticles (LNPs) as a delivery platform for nucleic acids were used in the COVID-19 vaccines and have received much attention. While modern manufacturing processes which involve rapidly mixing an organic stream containing the lipids with an aqueous stream containing the nucleic acids are conceptually straightforward, detailed understanding of LNP formation and structure is still limited and scale-up can be challenging. Mathematical and computational methods are a promising avenue for deepening scientific understanding of the LNP formation process and facilitating improved process development and control. This article describes strategies for the mechanistic modeling of LNP formation, starting with strategies to estimate and predict important physicochemical properties of the various species such as diffusivities and solubilities. Subsequently, a framework is outlined for constructing mechanistic models of reactor- and particle-scale processes. Insights gained from the various models are mapped back to product quality attributes and process insights. Lastly, the use of the models to guide development of advanced process control and optimization strategies is discussed.},
	urldate = {2025-08-05},
	journal = {Biotechnol. Adv.},
	author = {Inguva, Pavan K. and Mukherjee, Saikat and Walker, Pierre J. and Tenberg, Vico and Devos, Cedric and Shin, Sunkyu and Wu, Yanchen and Santra, Srimanta and Wang, Jie and Singh, Shalini and Kanso, Mona A. and Kim, Shin Hyuk and Trout, Bernhardt L. and Bazant, Martin Z. and Myerson, Allan S. and Braatz, Richard D.},
	month = nov,
	year = {2025},
	keywords = {Population balance model, Computational fluid dynamics, Lipid nanoparticles, Mathematical modeling, Phase-field model, RNA},
	pages = {108643},
	file = {ScienceDirect Snapshot:/Users/pierrewalker/Zotero/storage/JN8IDJ6W/S0734975025001296.html:text/html},
}

@article{gulatiElectrostaticallyDrivenCollapsePolyelectrolytes,
	title = {Electrostatically-{Driven} {Collapse} of {Polyelectrolytes}: {The} {Role} of the {Solvent}'s {Dielectric} {Constant}},
	volume = {n/a},
	copyright = {© 2025 The Author(s). Journal of Polymer Science published by Wiley Periodicals LLC.},
	issn = {2642-4169},
	shorttitle = {Electrostatically-{Driven} {Collapse} of {Polyelectrolytes}},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/pol.20250574},
	doi = {10.1002/pol.20250574},
	abstract = {We experimentally confirm a longstanding theoretical prediction of counterion-induced polyelectrolyte collapse in low dielectric media. The scattering behavior of polystyrene sulfonate in different solvents with dielectric permittivities in the range of {\textbackslash} {\textbackslash}varepsilon {\textbackslash}simeq 12-180 {\textbackslash} is investigated. For high and intermediate {\textbackslash} {\textbackslash}varepsilon {\textbackslash} media, typical polyelectrolyte behavior is observed: the correlation length ({\textbackslash} {\textbackslash}xi {\textbackslash}) scales with concentration ({\textbackslash} c {\textbackslash}) as {\textbackslash} {\textbackslash}xi {\textbackslash}sim c{\textasciicircum}-1/2 {\textbackslash}, as predicted by various theories. When the dielectric constant of the solvent decreases below {\textbackslash} {\textbackslash}simeq 22 {\textbackslash}, a scaling of {\textbackslash} {\textbackslash}xi {\textbackslash}sim c{\textasciicircum}-1/3 {\textbackslash}, characteristic of partially collapsed polyelectrolytes, is observed. For these solvents, the correlation peak disappears at high concentrations. Interestingly, polyelectrolyte collapse is observed under both solvophilic and solvophobic conditions, supporting the existence of attractive electrostatic interactions. These results are in qualitative agreement with theoretical predictions which expect chain collapse in low dielectric media due to the influence of condensed counterions, either via dipolar attraction and/or charge-correlation-induced attractions.},
	language = {en},
	number = {n/a},
	urldate = {2025-08-06},
	journal = {J. Polym. Sci.},
	author = {Gulati, Anish and Meng, Lingzi and Watanabe, Takaichi and Lopez, Carlos G.},
	keywords = {polyelectrolyte, counterion, dipole, SANS, SAXS, scattering},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/GHLBDQTQ/Gulati et al. - Electrostatically-Driven Collapse of Polyelectroly.pdf:application/pdf;Snapshot:/Users/pierrewalker/Zotero/storage/AN3B8E5D/pol.html:text/html},
}

