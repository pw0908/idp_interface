@article{singhStaticDielectricConstant2008,
	title = {Static {Dielectric} {Constant} of {Room} {Temperature} {Ionic} {Liquids}: {Internal} {Pressure} and {Cohesive} {Energy} {Density} {Approach}},
	volume = {112},
	issn = {1520-6106},
	shorttitle = {Static {Dielectric} {Constant} of {Room} {Temperature} {Ionic} {Liquids}},
	url = {https://doi.org/10.1021/jp8059618},
	doi = {10.1021/jp8059618},
	abstract = {Measurements of the static dielectric constant (ε) of ionic liquids (ILs) are very difficult because of the decay of field by the ionic conductivity of ILs. Herein, we describe an easy method for the prediction of ε of various imidazolium-based ILs [Cnmim] from n, i.e. the ratio of internal pressure (Pi) and cohesive energy density (ced). A calibration curve of n vs ε for conventional organic solvents (mainly the linear alcohols) has been used to estimate the ε of the ILs. Estimated ε values for ILs having the anions [Cl]−, [BF4]−, [PF6]−, [TfO]−, and [Tf2N]− showed a very good comparison with the literature results, whereas ILs having the anions [CnOSO3]− tend to deviate from such correlation. Also, for a series of ILs having a common anion, the ε is shown to follow a very good correlation with the molecular volumes. Predicted values show that both the nature of the anion and alkyl chain length of the cation contribute significantly to the ε of the ILs. The method developed makes use of properties which can be either experimentally determined or estimated with good accuracy and can be extended to the other categories of ILs with ease and reasonable accuracy.},
	number = {41},
	urldate = {2025-06-16},
	journal = {J. Phys. Chem. B},
	author = {Singh, Tejwant and Kumar, Arvind},
	month = oct,
	year = {2008},
	pages = {12968--12972},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/EP2P537J/Singh and Kumar - 2008 - Static Dielectric Constant of Room Temperature Ion.pdf:application/pdf},
}

