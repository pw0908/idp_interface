@article{mullerEvaluationRefinementNovel2019,
	title = {Evaluation and refinement of the novel predictive electrolyte model {COSMO}-{RS}-{ES} based on solid-liquid equilibria of salts and {Gibbs} free energies of transfer of ions},
	volume = {483},
	issn = {0378-3812},
	url = {https://www.sciencedirect.com/science/article/pii/S0378381218304515},
	doi = {10.1016/j.fluid.2018.10.023},
	abstract = {The new predictive electrolyte model COSMO-RS-ES is evaluated and refined for the calculation of solubilities of salts in mixed solvent systems. It is demonstrated that the model is capable of predicting solid-liquid equilibria at 25 °C for ammonium and alkali metal salts quite accurately in a wide variety of solvent mixtures. Furthermore, through the introduction of Gibbs free energies of transfer of single ions it is shown that the model performance can be improved even further. This new data type also allows for an ion-specific way of evaluating the model for the first time. For some systems when calculating the solubility, larger deviations are observed, but for the vast majority of systems the model delivers good predictions. This shows that COSMO-RS-ES is a valuable tool for calculation of phase equilibria in electrolyte systems especially when the scarcity of data impede the application of models that require a higher number of parameters.},
	urldate = {2025-10-20},
	journal = {Fluid Phase Equilib.},
	author = {Müller, Simon and González de Castilla, Andrés and Taeschler, Christoph and Klein, Andreas and Smirnova, Irina},
	month = mar,
	year = {2019},
	keywords = {COSMO-RS, COSMO-RS-ES, Electrolyte systems, Phase equilibria modelling, Solid-liquid equilibria},
	pages = {165--174},
	file = {ScienceDirect Full Text PDF:/Users/pierrewalker/Zotero/storage/5IR8JQBR/Müller et al. - 2019 - Evaluation and refinement of the novel predictive electrolyte model COSMO-RS-ES based on solid-liqui.pdf:application/pdf;ScienceDirect Snapshot:/Users/pierrewalker/Zotero/storage/NTYSSWA7/S0378381218304515.html:text/html},
}

@article{gerlachDevelopmentCOSMORSBased2018,
	title = {Development of a {COSMO}-{RS} based model for the calculation of phase equilibria in electrolyte systems},
	volume = {64},
	copyright = {© 2017 American Institute of Chemical Engineers},
	issn = {1547-5905},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/aic.15875},
	doi = {10.1002/aic.15875},
	abstract = {A new electrolyte model, which is based on the predictive thermodynamic model COSMO-RS, is presented. For this purpose, an implementation of COSMO-RS that allows the integration of multiple segment descriptors was developed. To aid in the development of the electrolyte model, a new technique is presented that allows the evaluation of the different contributions of the interaction terms of COSMO-RS to the partial molar enthalpies. General empirical interaction energy equations are introduced into the electrolyte model. They are parameterized based on a large training set of mean ionic activity coefficients as well as liquid–liquid equilibrium data close to ambient conditions. The model is shown to be capable of predicting properties of systems containing anions that were not part of the training set of the model. Furthermore, it is demonstrated that the model can also lead to satisfying predictions if compared to vapor–liquid equilibrium data. © 2017 American Institute of Chemical Engineers AIChE J, 63: 272–285, 2018},
	language = {en},
	number = {1},
	urldate = {2025-10-20},
	journal = {AIChE J.},
	author = {Gerlach, Thomas and Müller, Simon and Smirnova, Irina},
	year = {2018},
	keywords = {COSMO-RS, electrolyte systems, liquid–liquid equilibria, partial molar enthalpies},
	pages = {272--285},
}

@article{chenGeneralizedElectrolyteNRTLModel2004,
	title = {Generalized electrolyte-{NRTL} model for mixed-solvent electrolyte systems},
	volume = {50},
	copyright = {Copyright © 2004 American Institute of Chemical Engineers (AIChE)},
	issn = {1547-5905},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/aic.10151},
	doi = {10.1002/aic.10151},
	abstract = {A generalized electrolyte Non-Random Two-Liquid (eNRTL) model proposed by Chen and coworkers is presented as a comprehensive excess Gibbs energy expression to represent the liquid-phase nonideality for aqueous and mixed-solvent electrolyte systems over the entire concentration range from pure solvents to saturated solutions or fused salts. The eNRTL model is used to correlate mean ionic activity coefficients of mixed-solvent electrolyte systems. The segment interaction concept provides the framework necessary to represent the attractive interaction of ions with the hydrophilic segments of organic solvents and the repulsive interaction of ions with the hydrophobic segments of organic solvents. The ability to explicitly account for such distinctly different ion–segment interactions is shown to be the key for quantitative correlation of mean ionic activity coefficients in mixed-solvent electrolyte systems. © 2004 American Institute of Chemical Engineers AIChE J, 50: 1928–1941, 2004},
	language = {en},
	number = {8},
	urldate = {2025-10-20},
	journal = {AIChE J.},
	author = {Chen, Chau-Chyun and Song, Yuhua},
	year = {2004},
	keywords = {mixed solvents, NRTL, electrolyte thermodynamics, excess Gibbs energy, mean ionic activity coefficients},
	pages = {1928--1941},
	file = {Snapshot:/Users/pierrewalker/Zotero/storage/V3S6CFS6/aic.html:text/html},
}

