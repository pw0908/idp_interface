	pages = {1243--1247},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/K8AEAX95/Murmiliuk et al. - 2018 - Local pH and Effective pK of a Polyelectrolyte Cha.pdf:application/pdf},
}

