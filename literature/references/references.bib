	keywords = {Molecular dynamics, Hydrogels, Polyelectrolytes, Chemical reactions, Coarse-grained simulations, Diffusion-advection equation, Ferrofluids, Grand canonical Monte Carlo, Lattice-Boltzmann, Magnetic gels, Particle-based simulations, Reaction ensemble Monte Carlo},
