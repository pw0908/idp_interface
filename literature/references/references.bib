	year = {2019},
	keywords = {Monte Carlo, phase equilibrium, equations of state, gas condensates, hydrocarbons},
	pages = {792--803},
	file = {Snapshot:/Users/pierrewalker/Zotero/storage/E3SHC83J/aic.html:text/html},
}

