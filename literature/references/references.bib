	keywords = {Amino Acid Sequence, Humans, Animals, Organelles, Cell Nucleus, Computer Simulation, HeLa Cells, Hydrophobic and Hydrophilic Interactions, Intrinsically Disordered Proteins, Membrane Proteins, Mice, Models, Molecular, Mutation, Protein Domains, Proteomics, Static Electricity, Structure-Activity Relationship, Surface Properties, Time Factors, Transfection},
	pages = {72--85},
	file = {Full Text:/Users/pierrewalker/Zotero/storage/KVTJSC6B/Pak et al. - 2016 - Sequence Determinants of Intracellular Phase Separation by Complex Coacervation of a Disordered Prot.pdf:application/pdf;Full Text PDF:/Users/pierrewalker/Zotero/storage/APGBA7R6/Pak et al. - 2016 - Sequence Determinants of Intracellular Phase Separation by Complex Coacervation of a Disordered Prot.pdf:application/pdf},
