@article{oreillyIonicAggregateDissolution2015,
	title = {Ionic aggregate dissolution and conduction in a plasticized single-ion polymer conductor},
	volume = {59},
	issn = {0032-3861},
	url = {https://www.sciencedirect.com/science/article/pii/S003238611401101X},
	doi = {10.1016/j.polymer.2014.12.002},
	abstract = {Poly(ethylene glycol) plasticizer is blended with a PEO-based single-ion conductor to lower the glass transition temperature of the ionomer and solvate the lithium counterions. With increasing plasticizer content at room temperature, FTIR spectra indicate that the fraction of ions in isolated ion pairs increases relative to those in ionic aggregates, and X-ray scattering data indicate that the ionic aggregates are further apart than expected by dilution alone. Together these data show that the average size of ionic aggregates decreases as PEG plasticizer is added. The dissolution of aggregates into ion pairs promotes ion conduction. Coupled with faster segmental dynamics and ion mobility from the depressed Tg, the ionic conductivity of plasticized ionomers improved by two orders of magnitude at room temperature. Resolving the alpha relaxation of these ionomer blends reveals that the mechanism for ion transport is segmentally-assisted ion motion.},
