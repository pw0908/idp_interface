	keywords = {Thermodynamics, Ionic liquids, Polymer characterization, Polymer synthesis},
	pages = {242--248},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/FW7HESC4/Kodama et al. - 2011 - Structural effects of polyethers and ionic liquids.pdf:application/pdf},
}

