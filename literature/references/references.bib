	file = {Full Text:/Users/pierrewalker/Zotero/storage/SRNAXHFC/Fraggedakis et al. - 2020 - Dielectric Breakdown by Electric-field Induced Phase Separation.pdf:application/pdf},
}

@article{kolkerThermodynamicModelingConcentrated1995,
