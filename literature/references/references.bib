	keywords = {Good reporting practice, material properties, publication, reporting principles, thermophysical and thermochemical properties},
	pages = {253--272},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/DJ7NSWIS/Bazyleva et al. - 2021 - Good reporting practice for thermophysical and the.pdf:application/pdf},
}

@book{rubinsteinPolymerPhysics2003,
