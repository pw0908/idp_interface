@article{linChargePatternMatching2017,
	title = {Charge pattern matching as a ‘fuzzy’ mode of molecular recognition for the functional phase separations of intrinsically disordered proteins},
	volume = {19},
	issn = {1367-2630},
	url = {https://doi.org/10.1088/1367-2630/aa9369},
	doi = {10.1088/1367-2630/aa9369},
	abstract = {Biologically functional liquid–liquid phase separation of intrinsically disordered proteins (IDPs) is driven by interactions encoded by their amino acid sequences. Little is currently known about the molecular recognition mechanisms for distributing different IDP sequences into various cellular membraneless compartments. Pertinent physics was addressed recently by applying random-phase-approximation (RPA) polymer theory to electrostatics, which is a major energetic component governing IDP phase properties. RPA accounts for charge patterns and thus has advantages over Flory–Huggins (FH) and Overbeek–Voorn mean-field theories. To make progress toward deciphering the phase behaviors of multiple IDP sequences, the RPA formulation for one IDP species plus solvent is hereby extended to treat polyampholyte solutions containing two IDP species plus solvent. The new formulation generally allows for binary coexistence of two phases, each containing a different set of volume fractions for the two different IDP sequences. The asymmetry between the two predicted coexisting phases with regard to their ratios for the two sequences increases with increasing mismatch between their charge patterns. This finding points to a multivalent, stochastic, ‘fuzzy’ mode of molecular recognition that helps populate various IDP sequences differentially into separate phase compartments. An intuitive illustration of this trend is provided by FH models, whereby a hypothetical case of ternary coexistence is also explored. Augmentations of the present RPA theory with a relative permittivity that depends on IDP volume fraction lead to higher propensities to phase separate, in line with the case with one IDP species we studied previously. Notably, the cooperative, phase-separation-enhancing effects predicted by the prescriptions for we deem physically plausible are much more prominent than that entailed by common effective medium approximations based on Maxwell Garnett and Bruggeman mixing formulas. Ramifications of our findings on further theoretical development for IDP phase separation are discussed.},
	language = {en},
	number = {11},
	urldate = {2026-07-22},
	journal = {New J. Phys.},
	publisher = {IOP Publishing},
	author = {Lin, Yi-Hsuan and Brady, Jacob P and Forman-Kay, Julie D and Chan, Hue Sun},
	month = nov,
	year = {2017},
	pages = {115003},
	file = {IOP Full Text PDF:/Users/pierrewalker/Zotero/storage/YAXTY4C9/Lin et al. - 2017 - Charge pattern matching as a ‘fuzzy’ mode of molecular recognition for the functional phase separati.pdf:application/pdf;IOP Full Text PDF:/Users/pierrewalker/Zotero/storage/PNVPIBC5/Lin et al. - 2017 - Charge pattern matching as a ‘fuzzy’ mode of molecular recognition for the functional phase separati.pdf:application/pdf},
}

@article{linElectrostaticsSaltdependentReentrant2025,
	title = {Electrostatics of salt-dependent reentrant phase behaviors highlights diverse roles of {ATP} in biomolecular condensates},
	volume = {13},
	issn = {2050-084X},
	url = {https://doi.org/10.7554/eLife.100284},
	doi = {10.7554/eLife.100284},
	abstract = {Liquid-liquid phase separation (LLPS) involving intrinsically disordered protein regions (IDRs) is a major physical mechanism for biological membraneless compartmentalization. The multifaceted electrostatic effects in these biomolecular condensates are exemplified here by experimental and theoretical investigations of the different salt- and ATP-dependent LLPSs of an IDR of messenger RNA-regulating protein Caprin1 and its phosphorylated variant pY-Caprin1, exhibiting, for example, reentrant behaviors in some instances but not others. Experimental data are rationalized by physical modeling using analytical theory, molecular dynamics, and polymer field-theoretic simulations, indicating that interchain ion bridges enhance LLPS of polyelectrolytes such as Caprin1 and the high valency of ATP-magnesium is a significant factor for its colocalization with the condensed phases, as similar trends are observed for other IDRs. The electrostatic nature of these features complements ATP’s involvement in π-related interactions and as an amphiphilic hydrotrope, underscoring a general role of biomolecular condensates in modulating ion concentrations and its functional ramifications.},
	urldate = {2026-07-22},
	journal = {eLife},
	publisher = {eLife Sciences Publications, Ltd},
	author = {Lin, Yi-Hsuan and Kim, Tae Hun and Das, Suman and Pal, Tanmoy and Wessén, Jonas and Rangadurai, Atul Kaushik and Kay, Lewis E and Forman-Kay, Julie D and Chan, Hue Sun},
	editor = {Cui, Qiang},
	month = mar,
	year = {2025},
	keywords = {molecular dynamics, liquid-liquid phase separation, field-theoretic simulation, intrinsically disordered proteins, phosphorylation, random phase approximation},
	pages = {RP100284},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/8F5EVCIW/Lin et al. - 2025 - Electrostatics of salt-dependent reentrant phase behaviors highlights diverse roles of ATP in biomol.pdf:application/pdf},
}

@article{andersenOptimizedClusterExpansions1972,
	title = {Optimized {Cluster} {Expansions} for {Classical} {Fluids}. {III}. {Applications} to {Ionic} {Solutions} and {Simple} {Liquids}},
	volume = {57},
	issn = {0021-9606},
	url = {https://doi.org/10.1063/1.1678641},
	doi = {10.1063/1.1678641},
	abstract = {In a previous paper we have derived a number of simple approximations for the thermodynamic and structural properties of liquids. Here we test these approximations by applying them to models for ionic solutions and atomic liquids and comparing the results with those obtained from Monte Carlo and molecular dynamics simulations. In particular, the pair‐correlation functions for 1–1 primitive model aqueous ionic solutions are calculated using the EXP approximation. The internal energy for 2–2 salts is obtained from the ORPA+B2 approximation. The pair‐correlation function for the Lennard‐Jones fluid is calculated with the EXP approximation. In all cases the results obtained agree closely with those obtained from computer experiments. Thus, the ORPA+B2 approximation for the free energy and the EXP approximation for the pair correlation function provide a theory that is both very accurate and applicable to a wide variety of classical fluids.},
	number = {7},
	urldate = {2026-07-22},
	journal = {J. Chem. Phys.},
	author = {Andersen, Hans C. and Chandler, David and Weeks, John D.},
	month = oct,
