	url = {https://www.sciencedirect.com/science/article/pii/0022283667902409},
	doi = {10.1016/0022-2836(67)90240-9},
	abstract = {The conformation of polyriboadenylic acid (poly A) in aqueous solutions at neutral pH has been investigated under “ideal”, Θ solvent conditions, as a function of temperature. The studies were carried out on fractions of well-defined molecular weight obtained by reversible phase separation of the polymer in sodium chloride solutions more concentrated than 1 m. Under such conditions, poly A is soluble at low and high temperatures, but only partially miscible in a range centered on 35 to 40 °C. The extent of the range varies with molecular weight, and polymer and salt concentrations. The upper and lower Θ temperatures for solvents in the range of sodium chloride concentrations from 1 to 1.33 m were derived from the phase diagrams. Light-scattering experiments yielded the molecular weights, radii of gyration and second virial coefficients (A2) of several fractions at various salt concentrations, in the temperature range −2 to 62.4 °C. At a fixed salt concentration, A2 vanished at two temperatures, the upper and lower Θ temperatures for that solvent. In this way it was possible to obtain values of the radius of gyration at various Θ temperatures which were unperturbed by solvent effects, thus separating long-range solvent-dependent influences on molecular conformation from the influences of short-range interactions due to base stacking. The sedimentation velocity and viscosity behavior of poly A as a function of salt concentration and temperature were also studied. In 1 m-NaCl, both the sedimentation coefficient and intrinsic viscosity vary as M0.5 at a temperature quite close to the Θ temperature. The results show that poly A forms a highly extended structure at low temperature but that this structure is rapidly disrupted as the fraction of bases in stacks falls below unity. The observations are consistent with the existence of a structure formed by a non-co-operative process.},
	number = {1},
	urldate = {2026-10-22},
	journal = {J. Mol. Biol.},
	author = {Eisenberg, Henryk and Felsenfeld, Gary},
	month = nov,
	year = {1967},
	pages = {17--37},
	file = {ScienceDirect Full Text PDF:/Users/pierrewalker/Zotero/storage/YKG5T3J7/Eisenberg and Felsenfeld - 1967 - Studies of the temperature-dependent conformation and phase separation of polyriboadenylic acid solu.pdf:application/pdf;ScienceDirect Snapshot:/Users/pierrewalker/Zotero/storage/2D5PXMKW/0022283667902409.html:text/html},
}

@article{ponsroyoHighthroughputScreeningMRNA2026,
	title = {High-throughput screening of {mRNA} precipitate filterability using automated image analysis},
	volume = {390},
	issn = {1383-5866},
	url = {https://www.sciencedirect.com/science/article/pii/S1383586626002121},
	doi = {10.1016/j.seppur.2026.136946},
	abstract = {The integration of precipitation as a non-chromatographic, non-titer-dependent capture method has received increasing attention in continuous bioprocessing for biotherapeutics. Precipitation offers a scalable and cost-effective approach to separate biomolecules by reducing solubility through changes in pH, ionic strength, or the addition of precipitating agents. Following precipitation, efficient solid–liquid separation is required to remove formed solids from the liquid phase, a step commonly performed using tangential flow filtration. For continuous TFF operation, maintaining stable filtration performance over time is essential. A key factor is the critical flux, defined as the maximum permeate flux that can be sustained without significant membrane fouling. Previous studies, focused on monoclonal antibodies, have shown that buffer composition, salt type, and precipitant addition strategy strongly influence precipitate morphology and filterability. However, these relationships have not been evaluated for messenger RNA (mRNA). Accurate assessment of packing density is essential for predicting filtration performance; however, conventional techniques to determine the packing density suffer from limitations related to throughput, sample volume requirements and reproducibility. To address these challenges, a high-throughput image analysis-based method has been developed to evaluate the filterability of precipitated biomolecules, with mRNA serving as a model system. Morphological features extracted from visual data, including precipitate size and distribution, enable rapid screening of precipitation conditions, achieving up to a 90 \% reduction in material consumption compared to conventional methods. This approach facilitates the identification of optimal salts and additives to improve precipitation efficiency and downstream recovery, supporting the advancement of scalable precipitation-based capture strategies within integrated continuous biomanufacturing.},
	urldate = {2026-10-22},
	journal = {Separation and Purification Technology},
	author = {Pons Royo, Maria del Carme and Camara Largo, Mateo and Alonso Lopez, Didac and Ahmadi, Soroush and Hatas, Andrew and Myerson, Allan S. and Braatz, Richard D.},
	month = may,
	year = {2026},
	keywords = {Precipitation, Continuous bioprocessing, Critical flux, Filterability, Image analysis, Packing density},
	pages = {136946},
	file = {ScienceDirect Snapshot:/Users/pierrewalker/Zotero/storage/T3AS2YPJ/S1383586626002121.html:text/html},
}

@article{liPredictingMorphologyMultiphase2024,
	title = {Predicting the {Morphology} of {Multiphase} {Biomolecular} {Condensates} from {Protein} {Interaction} {Networks}},
	volume = {2},
	url = {https://link.aps.org/doi/10.1103/PRXLife.2.023013},
	doi = {10.1103/PRXLife.2.023013},
	abstract = {Phase-separated biomolecular condensates containing proteins and RNAs can assemble into higher-order structures by forming thermodynamically stable interfaces between immiscible phases. Using a minimal model of a protein/RNA interaction network, we demonstrate how a “shared” protein species that partitions into both phases of a multiphase condensate can function as a tunable surfactant that modulates the interfacial properties. We use Monte Carlo simulations and free-energy calculations to identify conditions under which a low concentration of this shared species is sufficient to trigger a wetting transition. We also describe a numerical approach based on classical density functional theory to predict concentration profiles and surface tensions directly from the model protein/RNA interaction network. Finally, we show that the wetting phase diagrams that emerge from our calculations can be understood in terms of a simple model of selective adsorption to a fluctuating interface. Our work shows how a low-concentration protein species might function as a biological switch for regulating multiphase condensate morphologies.},
	number = {2},
	urldate = {2026-10-23},
	journal = {PRX Life},
	publisher = {American Physical Society},
	author = {Li, Tianhao and Jacobs, William M.},
	month = jun,
	year = {2024},
	pages = {023013},
	file = {APS Snapshot:/Users/pierrewalker/Zotero/storage/XMJPHHIQ/PRXLife.2.html:text/html;Full Text PDF:/Users/pierrewalker/Zotero/storage/F98NH7AS/Li and Jacobs - 2024 - Predicting the Morphology of Multiphase Biomolecular Condensates from Protein Interaction Networks.pdf:application/pdf},
}

@article{polymeropoulos50thAnniversaryPerspective2017,
	title = {50th {Anniversary} {Perspective}: {Polymers} with {Complex} {Architectures}},
	volume = {50},
	issn = {0024-9297},
	shorttitle = {50th {Anniversary} {Perspective}},
	url = {https://doi.org/10.1021/acs.macromol.6b02569},
	doi = {10.1021/acs.macromol.6b02569},
	abstract = {The
scope of this Perspective is to highlight innovative contributions in the synthesis of well-defined complex macromolecular architectures and to emphasize the importance of these materials to polymer physical chemistry, physics, theory, and applications. In addition, this Perspective tries to enlighten the past and show possible pathways for the future. Among the plethora of polymerization methods, we briefly report the impact of the truly living and controlled/living polymerization techniques focusing mainly on anionic polymerization, the mother of all living and controlled/living polymerizations. Through anionic polymerization well-defined model polymers with complex macromolecular architectures having the highest molecular weight, structural and compositional homogeneity can be achieved. The synthesized structures include star, comb/graft, cyclic, branched and hyberbranched, dendritic, and multiblock multicomponent polymers. In our opinion, in addition to the work needed on the synthesis, properties, and application of copolymers with more than three chemically different blocks and complex architecture, the polymer chemists in the future should follow closer the approaches Nature, the perfect chemist, uses to make functional complex macromolecular structures by noncovalent chemistry. Moreover, development of new analytical methods for the characterization/purification of polymers with complex macromolecular architectures is essential for the synthesis and properties study of this family of polymeric materials.},
	number = {4},
	urldate = {2026-10-27},
	journal = {Macromolecules},
	author = {Polymeropoulos, George and Zapsas, George and Ntetsikas, Konstantinos and Bilalis, Panayiotis and Gnanou, Yves and Hadjichristidis, Nikos},
	month = feb,
	year = {2017},
	pages = {1253--1290},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/YGUC5ZN5/Polymeropoulos et al. - 2017 - 50th Anniversary Perspective Polymers with Complex Architectures.pdf:application/pdf;Snapshot:/Users/pierrewalker/Zotero/storage/3PMH2377/acs.macromol.html:text/html},
}

@article{theodorakisEffectiveInteractionParameter2007,
	title = {Effective interaction parameter of linear/star polymer blends and comparison with that of linear/linear and star/star blends},
	volume = {126},
	issn = {0021-9606},
	url = {https://doi.org/10.1063/1.2731786},
	doi = {10.1063/1.2731786},
	abstract = {The authors present a detailed study of the microscopic parameters, which control the miscibility in binary linear/star polymer blends. The effective interactions of linear/star polymer blends are studied by means of Monte Carlo simulations and comparison is made with linear/linear and star/star blends, which they also determined. Using the bond fluctuation model on a simple cubic lattice, the authors are able to simulate symmetric linear/linear, star/star, and, for the first time, linear/star blends with a moderate number of arms. The simulations were performed at a volume fraction of occupied lattice sites φ=0.5, which corresponds to dense polymer mixtures for this algorithm. In particular, we study star/star blends with 4, 8, and 12 arms and the respective linear/linear blends as well as linear/star blends, all having the same total number of units equal to 73 and 121. The authors find that linear/star blends are more miscible than the corresponding linear/linear blends, which is in agreement with recent experimental and theoretical results. They find that linear/star mixtures are less miscible than star/star blends, a result which is also verified by theoretical findings.},
	number = {17},
	urldate = {2026-10-27},
	journal = {The Journal of Chemical Physics},
	author = {Theodorakis, P. E. and Avgeropoulos, A. and Freire, J. J. and Kosmas, M. and Vlahos, C.},
	month = may,
	year = {2007},
	pages = {174904},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/9U8W652D/Theodorakis et al. - 2007 - Effective interaction parameter of linearstar polymer blends and comparison with that of linearlin.pdf:application/pdf;Snapshot:/Users/pierrewalker/Zotero/storage/DBD5LVC7/1.html:text/html},
}

@article{wuOriginAnomalousGuest2026,
	title = {Origin of the {Anomalous} {Guest} {Polymer} {Selectivity} in {Complex} {Coacervates}},
	volume = {20},
	issn = {1936-0851},
	url = {https://doi.org/10.1021/acsnano.6c06413},
	doi = {10.1021/acsnano.6c06413},
	abstract = {Complex coacervates─liquid condensates resulting
from liquid–liquid
phase separation of oppositely charged polymers─have attracted
broad interest in artificial cells, drug delivery vehicles, and smart nanoreactors. The functionality of these applications is significantly influenced by the coacervate’s ability to encapsulate guest
macromolecules, where the guest interactions determine their loading efficiency and activity. Using MD simulations, analytical theory, and experiments, we demonstrate that the intrinsic electrostatic correlations within the coacervate matrix significantly modify the effective interactions of guest polymers in the dense phase, resulting in the strong dependence of encapsulation on guest chain length, charge density, and charge sequence observed experimentally. Even in the absence of chemical incompatibility, neutral polymers are strongly excluded from the coacervate phase as a result of disrupting electrostatic correlations within coacervates. Consequently, the encapsulation efficiency of neutral polymers exponentially decays with increasing guest chain length. For polyampholyte-like intrinsically disordered proteins (IDPs), their effective interaction within coacervates is largely determined by charge sequence: IDPs with more-disordered sequences experience strict rejection from the dense phase, whereas those with more blocky charges are dispersed within coacervates. Interestingly, for all the guest species tested, their effective interactions are opposite to those observed in dilute solutions, where the sign of the effective two-body interaction reverses when going from the dilute phase to the dense coacervate phase. We elucidate that the non-trivial guest selectivity in complex coacervates originates from the disruption of polycation–polyanion electrostatic correlations by the guest, which combines an energetic penalty (dilution of charge density) with an entropic penalty (loss of chain conformational freedom of the host). These findings have significant implications for understanding guest behavior in coacervate and biocondensate systems.},
	number = {40},
	urldate = {2026-10-27},
	journal = {ACS Nano},
	author = {Wu, Zongpei and Sabadini, Júlia Bonesso and Walker, Pierre J. and Loh, Watson and Wang, Zhen-Gang and Perry, Sarah L. and Chen, Shensheng},
	month = oct,
	year = {2026},
	pages = {27054--27065},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/C79CBXEV/Wu et al. - 2026 - Origin of the Anomalous Guest Polymer Selectivity in Complex Coacervates.pdf:application/pdf;Snapshot:/Users/pierrewalker/Zotero/storage/3TYMDZRK/acsnano.html:text/html},
}

@article{walkerIonTransportEnhancement2026,
	title = {Ion {Transport} {Enhancement} in {Charge}-{Regulating} {Hydrogels}},
	issn = {1936-0851},
	url = {https://doi.org/10.1021/acsnano.6c12908},
	doi = {10.1021/acsnano.6c12908},
	abstract = {Weak
polyelectrolyte
hydrogels are emerging as a versatile
platform
for ion transport and separation, desalination, and energy applications. However, a predictive understanding of how dynamic charge regulation at the nanoscopic scale influences ionic mobility in these polymer networks remains elusive. Here, using large-scale molecular simulations, we dissect the coupled mechanisms governing small-ion transport in weak polyelectrolyte hydrogels, and reveal how charge density, competitive binding, and dynamic charge regulation jointly control ion mobility. By systematically isolating these effects, we uncover a pronounced
nonmonotonic dependence of ion self-diffusion on hydrogel pKa and salt concentration for multivalent ions.
Strikingly, allowing the hydrogel backbone to dynamically regulate
its charge eliminates this nonmonotonicity and leads to dramatic enhancements
in ion mobility, with diffusion coefficients increasing by more than
a factor of 2 for trivalent ions. We attribute this effect to a protonation-assisted
hopping mechanism that continuously remodels the local electrostatic
landscape, providing an additional molecular-scale pathway for ion
unbinding beyond translational escape and accelerating ion-pair kinetics
without affecting the fraction of free ions. Our results demonstrate
that dynamic nanoscale charge regulation can decouple ion mobility
from equilibrium binding strength, offering a powerful design lever
unavailable in fixed-charge materials. Building upon these insights,
we propose simple molecular design principles for next-generation
ion-conducting hydrogels and suggest alternative strategies for nanostructured
membranes, energy materials, and biologically inspired charge-adaptive
soft matter.},
	urldate = {2026-10-27},
	journal = {ACS Nano},
	author = {Walker, Pierre J. and Beyer, David and Holm, Christian and Wang, Zhen-Gang},
	month = oct,
	year = {2026},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/B46P8FWV/Walker et al. - 2026 - Ion Transport Enhancement in Charge-Regulating Hydrogels.pdf:application/pdf;Snapshot:/Users/pierrewalker/Zotero/storage/LM8JEBNE/acsnano.html:text/html},
}

@article{wangLivingScientificRecords2026,
	title = {Toward living scientific records through decentralized multi-agent systems for materials discovery},
	issn = {1938-1425},
	url = {https://doi.org/10.1557/s43577-026-01180-1},
	doi = {10.1557/s43577-026-01180-1},
	abstract = {Materials discovery depends on distributed evidence: literature, simulations, experiments, failed attempts, and expert judgment. Many AI-enabled scientific systems instead operate as transient pipelines whose reasoning path is hard to inspect or reuse. We argue the durable product of AI-assisted discovery should be a provenance-linked record of evidence, assumptions, failures, critiques, and unresolved needs, with agents and humans acting on this shared record rather than a scripted workflow. We discuss ScienceClaw \$\${\textbackslash}times\$\$Infinite as one implementation, demonstrated through a bounded resonance case study: feature extraction on 15 documented resonators, a computed feature-space coordinate that let the workflow check a proposed design against its own target, and a redesign that was verified to meet that target with a computational screen. Decentralized multi-agent systems more broadly point toward living scientific records where evidence and open questions remain available for reuse.},
	language = {en},
	urldate = {2026-10-30},
	journal = {MRS Bulletin},
	author = {Wang, Fiona Y. and Berkovich, Jaime A. and Marom, Lee and Buehler, Markus J.},
	month = oct,
	year = {2026},
	keywords = {Simulation, Machine learning, Informatics, Artificial intelligence, Autonomous research, Data/database},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/7DRKD49Q/Wang et al. - 2026 - Toward living scientific records through decentralized multi-agent systems for materials discovery.pdf:application/pdf},
}

@article{hsuSAGEQASharedcontextAgentic2026,
	title = {{SAGE}-{QA}: {Shared}-context agentic graph-enhanced question answering for scientific reasoning},
	issn = {2159-6867},
	shorttitle = {{SAGE}-{QA}},
	url = {https://doi.org/10.1557/s43579-026-01036-4},
	doi = {10.1557/s43579-026-01036-4},
	abstract = {SAGE-QA is a graph-grounded multi-agent framework for expert question answering over technical corpora. It maps query terms to entities in a domain knowledge graph, retrieves compact source-linked relation paths, and converts them into a shared graph-structured evidence state. Role-specialized agents use this state for planning, retrieval, critique, and synthesis, keeping reasoning traceable to explicit relations and source chunks. We evaluate SAGE-QA on ten semiconductor manufacturing questions from domain experts using an LLM-judge protocol with the same Meta-Llama-3.3-70B backbone. SAGE-QA improves average scores over the standalone backbone, especially in correctness, coverage, depth, and verifiability across academic, technical, and hybrid question groups.},
	language = {en},
	urldate = {2026-10-30},
	journal = {MRS Communications},
	author = {Hsu, Yu-Chuan and Buehler, Markus J.},
	month = sep,
	year = {2026},
	keywords = {Informatics, Artificial intelligence, Data/database, Computation/computing, Scale-up/manufacturing},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/CUX8IGPN/Hsu and Buehler - 2026 - SAGE-QA Shared-context agentic graph-enhanced question answering for scientific reasoning.pdf:application/pdf},
}

@misc{hageHierarchicalMultiAgentReasoning2026a,
	title = {Hierarchical {Multi}-{Agent} {Reasoning} {Systems} for {Knowledge}-{Grounded} {Material} {Substitution}},
	url = {https://arxiv.org/abs/2610.14123v1},
	doi = {https://doi.org/10.48550/arXiv.2608.26081},
	abstract = {AI-assisted scientific discovery increasingly seeks to move beyond generating plausible ideas toward reproducible, constraint-aware workflows that can support practical engineering decisions. We present MARS, a hierarchical Multi-Agent Reasoning System for knowledge-grounded material substitution under scientific and manufacturing constraints. We apply MARS to replace per- and polyfluoroalkyl substances (PFAS), a demanding materials-design problem in which substitutes must satisfy functional performance, environmental, experimental, and processing requirements. MARS decomposes substitution into a closed-loop workflow comprising requirement analysis, grounded candidate generation, and manufacturability assessment with process design. The system integrates retrieval-augmented generation, knowledge-graph reasoning, a database of lab-available materials, persistent memory of intermediate results, and rejection-aware iterative feedback. In a PFAS-substitution case study, MARS generates structured material requirements, identifies an evidence-grounded substitute candidate, and develops a lab-scale manufacturing route. In a multi-seed ablation evaluation, MARS achieves the highest overall performance across all three subsystems, with gains that persist when the backbone model is held fixed. These results suggest that hierarchical decomposition, knowledge grounding, and manufacturability-aware refinement improve material-substitution reasoning beyond model capability alone.},
	language = {en},
	urldate = {2026-10-30},
	publisher = {arXiv},
	author = {Hage, Tarjei Paule and Pal, Subhadeep and Lu, Wei and Hsu, Yu-Chuan and Lyon, Gayla and Jin, Jiezhu and Buehler, Markus J.},
	month = oct,
	year = {2026},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/SZA55WY2/Hage et al. - 2026 - Hierarchical Multi-Agent Reasoning Systems for Knowledge-Grounded Material Substitution.pdf:application/pdf},
}

@misc{palSwarmWorldStigmergicTechnological2026,
	title = {{SwarmWorld}: {Stigmergic} technological evolution in societies of language-model agents},
	shorttitle = {{SwarmWorld}},
	url = {https://arxiv.org/abs/2608.26081v1},
	doi = {https://doi.org/10.48550/arXiv.2608.26081v1},
	abstract = {Collective intelligence can emerge when individuals coordinate through a shared environment, allowing local actions to accumulate into durable social organization. Language-model agents offer a new substrate for this process, yet most multi-agent systems rely on direct conversation, predefined roles, or centralized workflows. It remains unclear whether decentralized agents can build functional technologies and outperform independent search. Here, initially homogeneous LLM agents in SwarmWorld self-organize without assigned roles or recipes into evolving technological societies. Agents explore a spatial environment, process resources, test materials, construct persistent artifacts, and write executable controllers evaluated by a deterministic simulator under unseen disturbances after the agents are removed. SwarmWorld splits cognition from consequence: agents propose architectures and controllers within fixed action and material schemas, while the simulated world determines function. Shared societies develop broader, more resilient technological portfolios than a strong best-of-N isolated-search baseline, although isolated search remains competitive for the strongest artifact. Agents differentiate into exploration, construction, maintenance, and coordination behaviors, transitioning as the world matures. Technologies accumulate through collaborative construction, executable inheritance, and persistent agent-artifact networks, with most reuse beginning through physical observation rather than communication. Explicit cultural mechanisms amplify collaboration and organization, but functional benefits depend on outcome and timescale. Physical stigmergy alone supports capable societies, while interaction drives persistent technological ecologies rather than universally superior individual inventions.},
	language = {en},
	urldate = {2026-10-30},
	publisher = {arXiv},
	author = {Pal, Subhadeep and Wang, Fiona Y. and Buehler, Markus J.},
	month = aug,
	year = {2026},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/LCJEDCYC/Pal et al. - 2026 - SwarmWorld Stigmergic technological evolution in societies of language-model agents.pdf:application/pdf},
}

@article{wangSwarmsLargeLanguage2026,
	title = {Swarms of large language model agents for protein sequence design with experimental validation},
	issn = {2635-098X},
	url = {https://doi.org/10.1039/d6dd00282j},
	doi = {10.1039/d6dd00282j},
	abstract = {Designing proteins de novo with tailored structural, physicochemical, and functional properties remains a grand challenge due to the vastness of sequence space and the complex coupling between sequence, structure, and function. Current generative methods, including protein language models and diffusion-based architectures, often require extensive fine-tuning, task-specific data, or model reconfiguration to support objective-directed design, limiting their flexibility and scalability. To overcome these limitations, we present a decentralized, multi-agent framework inspired by swarm intelligence where multiple LLM agents operate in parallel, each assigned to a specific residue position. These agents iteratively propose context-aware mutations by integrating design objectives, local neighborhood interactions, memory, and structural feedback from previous iterations. This decentralized coordination enables emergent design of diverse, well-defined sequences without reliance on motif scaffolds or multiple sequence alignments. The framework requires no task-specific training or fine-tuning, completes the iterative design process within a few GPU-hours, and produces sequences that span biologically plausible and previously unexplored regions of sequence space. We experimentally validated designed sequences using circular dichroism spectroscopy, confirming that an α-helical and a coil sequence each adopt their intended secondary structure in solution. Through benchmark tasks, architecture controls, trajectory analysis, and sequence–structure comparisons, we show that the framework supports programmable objective-directed searches across diverse structural, physicochemical, and functional design criteria without task-specific retraining. Our approach offers a versatile, training-free framework for multi-objective protein sequence optimization, demonstrating how decentralized residue-level agents can combine local proposal generation with global structure-level selection.},
	urldate = {2026-10-30},
	journal = {Digital Discovery},
	author = {Wang, Fiona Y. and Lee, Di Sheng and Kaplan, David L. and Buehler, Markus J.},
	month = aug,
	year = {2026},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/ZZ9KQ99L/Wang et al. - 2026 - Swarms of large language model agents for protein sequence design with experimental validation.pdf:application/pdf;Snapshot:/Users/pierrewalker/Zotero/storage/I47V9CUM/d6dd00282j.html:text/html},
}

@article{xieLearningNaturesAssembly2026,
	title = {Learning nature’s assembly language with polymers},
	volume = {123},
	url = {https://www.pnas.org/doi/10.1073/pnas.2519094123},
	doi = {10.1073/pnas.2519094123},
	abstract = {The self-assembly of matter into ordered structures is ubiquitous throughout nature and engineered systems. Programming a material’s macroscopic properties via molecular-level structural control is a grand scientific challenge, requiring methods for inverse design that can design a targeted molecule to achieve a given self-assembled structure. One model system that serves as a common proving ground for inverse design algorithms is block copolymers. In these systems, self-consistent field-theory (SCFT) provides a robust thermodynamic model for predicting self-assembly for a given molecular sequence. This work presents a computational algorithm which learns the reverse translation, allowing a target structure to be achieved by varying molecular sequence. The algorithm is based on development of an adjoint solution of the SCFT equations allowing incorporation of automatic differentiation. The power of this algorithm is demonstrated by inverse designing polymer sequences to yield equilibrium structures, resolving the long-standing dilemma of navigating the combinatorial explosion of sequence possibilities offered by complex copolymer designs. The inverse designed sequences show that the algorithm learns to modulate unfavorable block interactions to stabilize these complex morphologies. By learning how to program self-assembly at the molecular-level using only a thermodynamic model, this work opens the door to similar computational inverse design across other soft matter systems.},
	number = {7},
	urldate = {2026-10-30},
	journal = {Proceedings of the National Academy of Sciences},
	publisher = {Proceedings of the National Academy of Sciences},
	author = {Xie, Oliver and Cohen, Alexander E. and Bazant, Martin Z. and Olsen, Bradley D.},
	month = feb,
	year = {2026},
	pages = {e2519094123},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/N8MQVRG4/Xie et al. - 2026 - Learning nature’s assembly language with polymers.pdf:application/pdf},
}

