@article{zhaoAdditiveManufacturingSilica2020,
	title = {Additive manufacturing of silica aerogels},
	volume = {584},
	copyright = {2020 The Author(s), under exclusive licence to Springer Nature Limited},
	issn = {1476-4687},
	url = {https://www.nature.com/articles/s41586-020-2594-0},
	doi = {10.1038/s41586-020-2594-0},
	abstract = {Owing to their ultralow thermal conductivity and open pore structure1–3, silica aerogels are widely used in thermal insulation4,5, catalysis6, physics7,8, environmental remediation6,9, optical devices10 and hypervelocity particle capture11. Thermal insulation is by far the largest market for silica aerogels, which are ideal materials when space is limited. One drawback of silica aerogels is their brittleness. Fibre reinforcement and binders can be used to overcome this for large-volume applications in building and industrial insulation5,12, but their poor machinability, combined with the difficulty of precisely casting small objects, limits the miniaturization potential of silica aerogels. Additive manufacturing provides an alternative route to miniaturization, but was “considered not feasible for silica aerogel”13. Here we present a direct ink writing protocol to create miniaturized silica aerogel objects from a slurry of silica aerogel powder in a dilute silica nanoparticle suspension (sol). The inks exhibit shear-thinning behaviour, owing to the high volume fraction of gel particles. As a result, they flow easily through the nozzle during printing, but their viscosity increases rapidly after printing, ensuring that the printed objects retain their shape. After printing, the silica sol is gelled in an ammonia atmosphere to enable subsequent processing into aerogels. The printed aerogel objects are pure silica and retain the high specific surface area (751 square metres per gram) and ultralow thermal conductivity (15.9 milliwatts per metre per kelvin) typical of silica aerogels. Furthermore, we demonstrate the ease with which functional nanoparticles can be incorporated. The printed silica aerogel objects can be used for thermal management, as miniaturized gas pumps and to degrade volatile organic compounds, illustrating the potential of our protocol.},
	language = {en},
	number = {7821},
	urldate = {2026-10-12},
	journal = {Nature},
	publisher = {Nature Publishing Group},
	author = {Zhao, Shanyu and Siqueira, Gilberto and Drdova, Sarka and Norris, David and Ubert, Christopher and Bonnin, Anne and Galmarini, Sandra and Ganobjak, Michal and Pan, Zhengyuan and Brunner, Samuel and Nyström, Gustav and Wang, Jing and Koebel, Matthias M. and Malfait, Wim J.},
	month = aug,
	year = {2020},
	keywords = {Gels and hydrogels, Design, synthesis and processing, Materials for devices, Porous materials},
	pages = {387--392},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/KKJVMPN5/Zhao et al. - 2020 - Additive manufacturing of silica aerogels.pdf:application/pdf},
}

@article{rubinsteinElasticModulusEquilibrium1996,
	title = {Elastic {Modulus} and {Equilibrium} {Swelling} of {Polyelectrolyte} {Gels}},
	volume = {29},
	issn = {0024-9297},
	url = {https://doi.org/10.1021/ma9511917},
	doi = {10.1021/ma9511917},
	abstract = {We present a scaling theory for the modulus G of
polyelectrolyte gels as a function of strand
length between cross-links, monomer concentration c, salt
concentration cs, and preparation
conditions
(monomer concentration c0 and salt concentration cs°). The theory assumes affine displacement of the
junction points when the concentration is changed. With no added
salt (cs = cs° =
0), we predict a new
concentration dependence of the modulus G ∼ c5/6. In the high-salt limit, we predict the usual
concentration dependence for uncharged polymers but a novel dependence on salt concentration, G ∼ c7/12cs1/4.
We also predict the modulus to decrease as charge is added to the gel strands. The predicted
effects of added salt and charge on modulus have recently been observed by Candau and co-workers. At
low concentrations, we discuss the strong stretching of network strands and its effect on modulus and
equilibrium swelling.},
	number = {1},
	urldate = {2026-10-12},
	journal = {Macromolecules},
	author = {Rubinstein, Michael and Colby, Ralph H. and Dobrynin, Andrey V. and Joanny, Jean-Francois},
	month = jan,
	year = {1996},
	pages = {398--406},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/9AD9VQK6/Rubinstein et al. - 1996 - Elastic Modulus and Equilibrium Swelling of Polyelectrolyte Gels.pdf:application/pdf;Snapshot:/Users/pierrewalker/Zotero/storage/JIDK6EJX/ma9511917.html:text/html},
}

@article{linMolecularDesignPrinciples2026,
	title = {Molecular design principles of hydrogels for food texture reconstruction and their oral processing responses},
	issn = {2772-5669},
	url = {https://www.sciencedirect.com/science/article/pii/S2772566926000698},
	doi = {10.1016/j.jfutfo.2026.02.006},
	abstract = {Hydrogels, with three-dimensional networks and responsive properties, offer innovative solutions for precise food texture reconstruction. This review systematically examines the mechanisms by which hydrogels modulate food texture and their dynamic responses during oral processing. Hydrogels achieve texture modification through molecular design (e.g., protein-polysaccharide interactions and ionic crosslinking), structural engineering (e.g., heterogeneous networks and porosity control), and advanced processing techniques (e.g., 3D printing and high-pressure treatment). These strategies enable tailored control over mechanical properties, tribological properties and temporal characteristics, which collectively define sensory perception. During oral processing, hydrogel-based textures exhibit critical functional responses. Optimized cohesiveness and yield stress reduce bolus fragmentation, shortening pharyngeal transit time and mitigating aspiration risks, particularly vital for dysphagia management. Microgel lubrication mimics fats’ lubrication effect, lowering friction coefficients to enhance smoothness in low-fat products. Furthermore, encapsulation within hydrogel networks enables controlled release of flavors and nutrients, improving sensory continuity and nutritional functionality. These attributes make hydrogels highly effective for developing reduced-fat/salt/sugar foods, plant-based meat analogues, and 3D-printed personalized foods. Future advancements hinge on intelligent stimuli-responsive hydrogels, personalized texture design based on oral physiology, and sustainable biomaterials derived from food processing by-products. Integrating these innovations may drive the next generation of hydrogels for precision nutrition, enhancing both sensory pleasure and health outcomes.},
	urldate = {2026-10-12},
	journal = {J. Future Foods},
	author = {Lin, Duanquan and Cao, Min-Jie and Sun, Le-Chang},
	month = feb,
	year = {2026},
	keywords = {Hydrogel, Functional food, Oral processing, Structural design, Texture modification},
	file = {ScienceDirect Full Text PDF:/Users/pierrewalker/Zotero/storage/CDIGNQ73/Lin et al. - 2026 - Molecular design principles of hydrogels for food texture reconstruction and their oral processing r.pdf:application/pdf},
}

