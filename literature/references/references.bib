	issn = {0169-409X},
	url = {https://www.sciencedirect.com/science/article/pii/S0169409X11000615},
	doi = {10.1016/j.addr.2011.03.010},
	abstract = {Review of basic principles and recent developments in the area of stimuli responsive polymeric capsules and nanoshells formed via layer-by-layer (LbL) is presented. The most essential attributes of the LbL approach are multifunctionality and responsiveness to a multitude of stimuli. The stimuli can be logically divided into three categories: physical (light, electric, magnetic, ultrasound, mechanical, and temperature), chemical (pH, ionic strength, solvent, and electrochemical) and biological (enzymes and receptors). Using these stimuli, numerous functionalities of nanoshells have been demonstrated: encapsulation, release including that inside living cells or in tissue, sensors, enzymatic reactions, enhancement of mechanical properties, and fusion. This review describes mechanisms and basic principles of stimuli effects, describes progress in the area, and gives an outlook on emerging trends such as theranostics and nanomedicine.},
	number = {9},
