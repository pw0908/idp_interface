	keywords = {Water, Thermodynamics, Solvents, Ions, Static Electricity, Molecular Dynamics Simulation, Particle Size, Solutions},
	pages = {044105},
}

@article{spencerSelfconsistentFieldTheory2022,
	title = {Self-consistent field theory of chiral nematic worm-like chains},
	volume = {156},
	issn = {0021-9606},
	url = {https://doi.org/10.1063/5.0078937},
	doi = {10.1063/5.0078937},
	abstract = {Many macromolecules of biological and technological interest are both chiral and semi-flexible. DNA and collagen are good examples. Such molecules often form chiral nematic (or cholesteric) phases, as is well-documented in collagen and chitin. This work presents a method for studying cholesteric phases in the highly successful self-consistent field theory of worm-like chains, offering a new way of studying many biologically relevant molecules. The method involves an effective Hamiltonian with a chiral term inspired by the Oseen–Frank (OF) model of liquid crystals. This method is then used to examine the formation of cholesteric phases in chiral-nematic worm-like chains as a function of polymer flexibility, as well as the optimal cholesteric pitch and distribution of polymer segment orientations. Our approach not only allows for the determination of the isotropic–cholesteric transition and segment distributions, beyond what the OF model promises, but also explicitly incorporates polymer flexibility into the study of the cholesteric phase, offering a more complete understanding of the behavior of semiflexible chiral-nematic polymers.},
	number = {11},
	urldate = {2026-09-16},
	journal = {J. Chem. Phys.},
	author = {Spencer, Russell K. W. and Ha, Bae-Yeun and Saeidi, Nima},
	month = mar,
	year = {2022},
	pages = {114902},
	file = {Snapshot:/Users/pierrewalker/Zotero/storage/HP96CYIL/5.html:text/html},
}

@article{reendersCompositionalOrientationalOrdering2002,
	title = {Compositional and {Orientational} {Ordering} in {Rod}−{Coil} {Diblock} {Copolymer} {Melts}},
	volume = {35},
	issn = {0024-9297},
	url = {https://doi.org/10.1021/ma011777v},
	doi = {10.1021/ma011777v},
	abstract = {The phase behavior of a melt of monodisperse rod−coil diblocks is studied. We derive a
Landau free energy functional for both a compositional and a nematic order parameter. The excluded
volume interaction between the rod blocks is modeled by an attractive Maier−Saupe interaction. The
incompatibility between rod and coil blocks is modeled by the usual Flory−Huggins interaction. For a
large volume fraction of the rods, a transition from isotropic to nematic to smectic C is observed upon
decreasing the temperature, whereas for small rod volume fraction, spherical, hexagonal, and lamellar
structures prevail. In the smectic C phase, the rod orientation angle with respect to the lamellar normal
increases rapidly from 35 to 40° close to the nematic/smectic-C phase boundary to values between 45
and 55°.},
	number = {8},
	urldate = {2026-09-16},
	journal = {Macromolecules},
