	keywords = {Electrochemical performance, Gelation chemistries, Hydrogel polymer electrolytes, Zinc metal anodes, Zinc-ion batteries},
	pages = {100294},
	file = {ScienceDirect Snapshot:/Users/pierrewalker/Zotero/storage/IS4CJGIW/S266714172400082X.html:text/html},
}

@article{zhengPhaseSeparationPolyelectrolytes2021,
	title = {Phase {Separation} of {Polyelectrolytes}: {The} {Effect} of {Charge} {Regulation}},
	volume = {125},
	issn = {1520-6106},
	shorttitle = {Phase {Separation} of {Polyelectrolytes}},
	url = {https://doi.org/10.1021/acs.jpcb.1c01986},
	doi = {10.1021/acs.jpcb.1c01986},
	abstract = {Complex coacervation, known as the liquid–liquid phase separation of solutions with oppositely charged polyelectrolytes, has attracted substantial interest in recent years. We study the effect of the charge regulation (CR) mechanism on the complex coacervation by including short-range interactions between the charged sites on the polymer chains as well as an association–dissociation energy parameter in the CR mechanism. We investigate the phase diagrams of two CR models: (i) the hopping CR model (HCR) and (ii) the asymmetric CR model (ACR). It is shown that during the phase separation that the polymers in the condensed phase are more charged than those in the dilute phase, in accordance with Le Chatelier’s principle. In addition, secondary CR effects also influence the change in the volume fraction of the two phases. The latter can cause the charge difference between the two phases to change nonmonotonically as a function of the CR parameters.},
	number = {28},
	urldate = {2025-02-05},
	journal = {J. Phys. Chem. B},
	author = {Zheng, Bin and Avni, Yael and Andelman, David and Podgornik, Rudolf},
	month = jul,
	year = {2021},
	pages = {7863--7870},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/ULTE7226/Zheng et al. - 2021 - Phase Separation of Polyelectrolytes The Effect o.pdf:application/pdf;Full Text PDF:/Users/pierrewalker/Zotero/storage/GZYJAA6R/Zheng et al. - 2021 - Phase Separation of Polyelectrolytes The Effect of Charge Regulation.pdf:application/pdf},
}

@article{chenChargeAsymmetrySuppresses2023,
	title = {Charge {Asymmetry} {Suppresses} {Coarsening} {Dynamics} in {Polyelectrolyte} {Complex} {Coacervation}},
	volume = {131},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.131.218201},
	doi = {10.1103/PhysRevLett.131.218201},
	abstract = {Mixing solutions of oppositely charged macromolecules can result in liquid-liquid phase separation into a polymer-rich coacervate phase and a polymer-poor supernatant phase. Here, we show that charge asymmetry in the constituent polymers can slow down the coarsening dynamics, with an apparent growth exponent that deviates from the well-known 1/3 for neutral systems and decreases with increasing degrees of charge asymmetry. Decreasing solvent quality accelerates the coarsening dynamics for asymmetric mixtures but slows down the coarsening dynamics for symmetric mixtures. We rationalize these results by examining the interaction potential between merging droplets.},
	number = {21},
	urldate = {2025-02-05},
	journal = {Phys. Rev. Lett.},
	author = {Chen, Shensheng and Wang, Zhen-Gang},
	month = nov,
	year = {2023},
