@article{shenInterfacialStructureDifferential2020,
	title = {Interfacial structure and differential capacitance of ionic liquid/graphite interface: {A} perturbed-chain {SAFT} density functional theory study},
	volume = {310},
	issn = {0167-7322},
	shorttitle = {Interfacial structure and differential capacitance of ionic liquid/graphite interface},
	url = {https://www.sciencedirect.com/science/article/pii/S0167732220316159},
	doi = {10.1016/j.molliq.2020.113199},
	abstract = {The perturbed-chain statistical associating fluid theory (PC-SAFT) equation of state (EoS) was combined with the electrostatic free energy from the mean spherical approximation (MSA) theory, and applied to represent densities of pure imidazolium ionic liquids (ILs) with anion [BF4]−. The PC-SAFT parameters of cations were linearized with their molar mass and obtained by simultaneously fitting the model predictions to experimental densities of some ILs. The PC-SAFT-MSA model provides accurate correlations and predictions of densities comparing with experimental data. Then a classical density functional theory (DFT) was developed based on PC-SAFT-MSA. The DFT model was applied to explore the structure and differential capacitance of the electrical double layer (EDL) in ILs on graphite. The model predicts similar density profiles for both cation and anion on a neutral surface, and layered structure with alternating layers of cations and anions on a charged surface. The charge inversion phenomena were also studied based on ion distributions. We further studied the effects of the alkyl chain length, temperature and non-electrostatic solid-fluid interactions on the differential capacitance of the EDL. The model provides bell-shaped differential capacitance curves. The peak positions of differential capacitance curves shift toward positive potentials as ions size asymmetry increases in agreement with previous experiments and simulations studies. The maximum capacitance decreases with increasing alkyl chain length as well as increasing temperature.},
	urldate = {2023-05-11},
	journal = {J. Mol. Liq.},
	author = {Shen, Gulou and Sun, Yunhao and Wang, Yu and Lu, Xiaohua and Ji, Xiaoyan},
	month = jul,
	year = {2020},
	keywords = {PC-SAFT, Ionic liquid, Density functional theory, Differential capacitance, Electrical double layer},
	pages = {113199},
	file = {ScienceDirect Full Text PDF:/Users/pierrewalker/Zotero/storage/88D2Y2QR/Shen et al. - 2020 - Interfacial structure and differential capacitance.pdf:application/pdf;ScienceDirect Snapshot:/Users/pierrewalker/Zotero/storage/ZR7AJVQP/S0167732220316159.html:text/html},
}

@article{maDynamicDensityFunctional2022,
	title = {Dynamic density functional theory for the charging of electric double layer capacitors},
	volume = {156},
	issn = {0021-9606},
	url = {https://doi.org/10.1063/5.0081827},
	doi = {10.1063/5.0081827},
	abstract = {We consider the charging of a model capacitor comprised of two planar electrodes and an electrolyte. Upon switching on a voltage difference, electric double layers build up in this setup, which we characterize with a classical dynamic density functional theory (DDFT) that accounts for electrostatic correlations and for molecular excluded volume of finite-sized ions and solvent molecules. Our DDFT predicts the electrode charge Q(t) to form exponentially with two timescales: at early times, the system relaxes on the RC time, namely, λDL/[D(2 + σ/λD)], with λD being the Debye length, L being the electrode separation, σ being the ion diameter, and D being the ionic diffusivity. Contrasting an earlier DDFT study, this early-time response does not depend on the applied potential. At late times, the capacitor relaxes with a relaxation time proportional to the diffusion time L2/D.},
	number = {8},
	urldate = {2023-05-11},
	journal = {J. Chem. Phys.},
	author = {Ma, Ke and Janssen, Mathijs and Lian, Cheng and van Roij, René},
	month = feb,
	year = {2022},
	pages = {084101},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/H9I4E7NA/Ma et al. - 2022 - Dynamic density functional theory for the charging.pdf:application/pdf;Snapshot:/Users/pierrewalker/Zotero/storage/8RQ3JQKZ/Dynamic-density-functional-theory-for-the-charging.html:text/html},
}

