	shorttitle = {Thermodynamics of pharmaceuticals},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0378381210004565},
	doi = {10.1016/j.fluid.2010.08.029},
	abstract = {A new scheme is presented for the parameterization of pharmaceuticals in the context of the perturbedchain statistical associating ﬂuid theory (PC-SAFT). The pharmaceutical parameters are ﬁtted to experimental solubility values in three different solvents, i.e., a hydrophilic, a polar, and a hydrophobic solvent. Subsequently, the solubility of the pharmaceuticals in other solvents is predicted without the need for additional interaction parameters. The approach is presented for six commonly used pharmaceutical compounds (paracetamol, naproxen, ibuprofen, ﬂurbiprofen, ketoprofen, and lovastatin) in numerous pure and mixed solvents, and in different temperatures.},
