	pages = {233--267},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/4UDYR895/Siegel - 1993 - Hydrophobic weak polyelectrolyte gels Studies of .pdf:application/pdf},
}

@article{kwonPolyelectrolyteGelsFundamentalsApplications2006,
