@article{ermoshkinModifiedRandomPhase2003,
	title = {A {Modified} {Random} {Phase} {Approximation} of {Polyelectrolyte} {Solutions}},
	volume = {36},
	issn = {0024-9297},
	url = {https://doi.org/10.1021/ma034148p},
	doi = {10.1021/ma034148p},
	abstract = {We compute the phase diagrams of salt-free polyelectrolyte solutions, using a modified Debye−Hückel approach. We introduce the chain connectivity via the random phase approximation with three modifications. First, we modify the electrostatic potential at short distances to include a boundary on the electrostatic attractions at the distance of closest approach between charges, which is important in semidilute solutions. This modification is shown to act as a hard core contribution in solutions of simple electrolytes. Second, we introduce a cutoff on the integration of the modes of wavelength smaller than the size over which the electrostatic attractions cannot be linearized and strongly perturbed chain are expected. A concentration-dependent cutoff is shown to be essential to predict physically reasonable phase diagrams. Third, ion condensation is included self-consistently. The modification does not give correct phase diagrams without the concentration-dependent cutoff. The combined modifications give phase diagrams in agreement with Monte Carlo simulations.},
	number = {20},
	urldate = {2025-06-12},
	journal = {Macromolecules},
	author = {Ermoshkin, A. V. and Olvera de la Cruz, M.},
	month = oct,
	year = {2003},
	pages = {7824--7832},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/SGRUFE78/Ermoshkin and Olvera de la Cruz - 2003 - A Modified Random Phase Approximation of Polyelect.pdf:application/pdf;Full Text PDF:/Users/pierrewalker/Zotero/storage/NUPZC7M6/Ermoshkin and Olvera de la Cruz - 2003 - A Modified Random Phase Approximation of Polyelectrolyte Solutions.pdf:application/pdf;Submitted Version:/Users/pierrewalker/Zotero/storage/EIC3Z935/Ermoshkin and Olvera de la Cruz - 2003 - A Modified Random Phase Approximation of Polyelectrolyte Solutions.pdf:application/pdf},
}

@article{renSpecificSaltEffects2011,
	title = {Specific {Salt} {Effects} on {Poly}(ethylene oxide) {Electrolyte} {Solutions}},
	volume = {44},
	issn = {0024-9297},
	url = {https://doi.org/10.1021/ma1027752},
	doi = {10.1021/ma1027752},
	abstract = {Exploring the mechanism of specific salt effects in electrolyte solutions is an old and attractive subject. It has been gradually realized that the competition at the molecular level plays an important role. Aiming to include molecular details as many as possible, we combine molecular dynamics (MD) simulations with a molecular theory to study specific salt effects on poly(ethylene oxide) (PEO) solutions with the addition of monovalent salt. Radial distribution functions obtained from MD simulations provide microscopic structures of different components as well as interactions between various species. On the basis of these interactions, we construct the molecular theory with four assumptions: (1) an ion along with bound water in the first shell works as a single entity; (2) short-ranged interactions among various species are modeled as hydrogen-bonding interactions; (3) the ability of a hydrated ion to provide donors/acceptors for hydrogen bonding is governed by the charge density; (4) contact ion pairs are included, especially in the cases of small cations. The molecular theory is generalized with the explicit inclusion of ion−PEO, ion−water, ion−ion, water−water, and water−PEO hydrogen bonds. This means the molecular-scale structure and interaction are included within the frame of the theory. Theoretically calculated cloud points verify that the salting-out ability for alkali metal ions follows the series of K+ {\textgreater} Rb+ {\textgreater} Cs+ {\textgreater} Na+ {\textgreater} Li+, which is in agreement with the experimental observations. Here, the competition among ion−PEO, ion−water, and water−PEO interactions and the impact of steric repulsions induced by the introduction of ions are two essential factors determining the phase behavior of PEO solutions. The combined methods bridge the microscopic interactions and structures to the macroscopic behavior.},
	number = {6},
	urldate = {2025-06-15},
	journal = {Macromolecules},
	author = {Ren, Chun-lai and Tian, Wen-de and Szleifer, Igal and Ma, Yu-qiang},
	month = mar,
	year = {2011},
	pages = {1719--1727},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/EDJSP4KV/Ren et al. - 2011 - Specific Salt Effects on Poly(ethylene oxide) Elec.pdf:application/pdf},
}

