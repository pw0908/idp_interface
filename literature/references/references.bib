	year = {2023},
	pages = {701--735},
	file = {ACS Full Text Snapshot:/Users/pierrewalker/Zotero/storage/ZWPMRFRJ/acs.chemrev.html:text/html;Full Text PDF:/Users/pierrewalker/Zotero/storage/SH7J8788/Li et al. - 2023 - Intrinsically Self-Healing Polymers From Mechanis.pdf:application/pdf},
}

