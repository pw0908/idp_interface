@article{dozInfluenceTemperatureLiquid+liquid2011,
	title = {Influence of temperature on the (liquid+liquid) equilibria of \{methanol+benzene+hexane\} ternary system},
	volume = {305},
	issn = {0378-3812},
	url = {https://www.sciencedirect.com/science/article/pii/S0378381211001087},
	doi = {10.1016/j.fluid.2011.02.022},
	abstract = {In order to show the influence of temperature on the liquid–liquid equilibria (LLE) of \{methanol(1)+benzene(2)+hexane(3)\} ternary system, equilibrium data at T=(278.15, 283.15, and 293.15)K are reported. The effect of the temperature on liquid–liquid equilibrium is determined and discussed. Ternary system is available from the literature at T=298K. All chemicals were quantified by gas chromatography using a thermal conductivity detector. The solubility data for methanol+hexane and the upper critical temperature (UCST) at 308.3K was reported. The tie line data for the ternary system were satisfactorily correlated by the Othmer and Tobias method, and the plait point coordinates for the three temperatures were estimated. Experimental data for the ternary system are compared with values calculated by the NRTL and UNIQUAC equations, and predicted by means of the UNIFAC group contribution method. It is found that the UNIQUAC and NRTL models provide similar good correlations of the equilibrium data at these three temperatures. Finally, the UNIFAC model predicts an immiscibility region larger than the experimental observed. Distribution coefficients were also analysed through distribution curves.},
	number = {1},
	urldate = {2022-11-14},
	journal = {Fluid Phase Equilib.},
	author = {Doz, Mónica B. Gramajo de and Bonatti, Carlos M. and Lucena, María C. and González, Diego A. and Mancilla, Marcos E.},
	month = jun,
	year = {2011},
	keywords = {Benzene, Data, Hexane, Liquid–liquid equilibria, Methanol, Ternary system},
	pages = {34--38},
	file = {ScienceDirect Full Text PDF:/Users/pierrewalker/Zotero/storage/H5C7Z5QM/Doz et al. - 2011 - Influence of temperature on the (liquid+liquid) eq.pdf:application/pdf;ScienceDirect Snapshot:/Users/pierrewalker/Zotero/storage/52RSWJ8S/S0378381211001087.html:text/html},
}

