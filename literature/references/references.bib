@article{delacruzPrecipitationHighlyCharged1995,
	title = {Precipitation of highly charged polyelectrolyte solutions in the presence of multivalent salts},
	volume = {103},
	issn = {0021-9606},
	url = {https://doi.org/10.1063/1.470459},
	doi = {10.1063/1.470459},
	abstract = {Solutions of highly charged polyelectrolyte chains are described by a model that introduces ion condensation as a random charge along the polymer. The degree of condensation is obtained by solving the Poisson–Boltzmann equation with cylindrical geometry. Short range electrostatic attractions between the monomers via the condensed counterions of high enough valency lead to reversible chain precipitation. The range of polymer concentration over which salt‐free solutions are unstable is determined, as well as the miscibility of the chains when salt is added. Redissolution at high salt concentration is due to a screening of the short range electrostatic attractions. Precipitation of chains in mixtures of movalent and multivalent salts is also studied. We find the range of salt concentration where chains precipitate. The model explains the experimental results on the precipitation of sodium and lanthanum polystyrene sulfonate solutions in presence of multivalent salts [LaCl3 and Th(NO3)4].},
	number = {13},
	urldate = {2023-05-07},
	journal = {J. Chem. Phys.},
	author = {de la Cruz, M. Olvera and Belloni, L. and Delsanti, M. and Dalbiez, J. P. and Spalla, O. and Drifford, M.},
	month = oct,
