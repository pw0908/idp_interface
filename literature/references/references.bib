	pages = {3425--3433},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/RJRHLYYR/Naficy et al. - 2012 - Electrically Conductive, Tough Hydrogels with pH Sensitivity.pdf:application/pdf},
}

@article{zhangUltraelasticIonicConductiveHydrogel2026,
	title = {Ultraelastic {Ionic}-{Conductive} {Hydrogel} {Pressure} {Sensor} with {Nano}-{Interpenetrating} {Networks} for {Fruit} {Classification}},
	volume = {8},
	url = {https://doi.org/10.1021/acsapm.5c03534},
	doi = {10.1021/acsapm.5c03534},
	abstract = {The design of hydrogel-based pressure sensors that combine long-term stability with wide-range pressure detection remains a significant scientific challenge. Such sensors require hydrogels with superior mechanical strength, electrical conductivity, low hysteresis, and dehydration resistance. This study developed a low-hysteresis (LH) hydrogel using a nanointerpenetrating polymerization strategy, which introduces nanochannel confinement and strong hydrogen bonding interactions to enable reversible energy dissipation and minimize elastic hysteresis. To enhance mechanical robustness and ionic conductivity, glycerol and lithium chloride (LiCl) were incorporated into the hydrogel network. The optimized LH hydrogel demonstrated excellent compressive properties, including elastic recovery under 90\% strain at 1.2 MPa, toughness of 1 MJ·m–3, and high ionic conductivity (0.29 S·m–1). The corresponding pressure sensor exhibited ultrahigh sensitivity in low-pressure regimes ({\textless}5 kPa, 9.4 kPa–1), while maintaining linear response in high-pressure environments ({\textgreater}170 kPa, 0.02 kPa–1) and stable performance over 4000 compression cycles. The sensor effectively monitored physiological signals such as radial pulse, respiration, and swallowing. Furthermore, integration into a soft robotic gripper enabled fruit classification with a recognition accuracy of 97.04\% using a deep learning algorithm. These results underscore the potential of LH hydrogels for next-generation wearable electronics and intelligent robotic applications.},
	number = {1},
	urldate = {2026-02-11},
	journal = {ACS Appl. Polym. Mater.},
	publisher = {American Chemical Society},
	author = {Zhang, Peiqi and Xiao, Longya and Zhang, Qiurui and Lai, Jinxin and Yin, Zhuhui and Hu, Quan and Aw, Kean C. and Jiang, Hongjie},
	month = jan,
	year = {2026},
	pages = {209--220},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/34YLVUUN/Zhang et al. - 2026 - Ultraelastic Ionic-Conductive Hydrogel Pressure Sensor with Nano-Interpenetrating Networks for Fruit.pdf:application/pdf},
}

@article{zhengIonicallyConductiveSelfHealing2023,
	title = {Ionically {Conductive} and {Self}-{Healing} {Polyampholyte} {Hydrogels} for {Wearable} {Resistive} {Strain} {Sensors} and {Capacitive} {Pressure} {Sensors}},
	volume = {5},
	url = {https://doi.org/10.1021/acsapm.3c01497},
	doi = {10.1021/acsapm.3c01497},
	abstract = {Hydrogels are promising materials for flexible wearable sensors, but they often suffer from unpredictable mechanical damage. In this work, self-healing polyampholyte hydrogels are developed and explored in constructing wearable mechanosensors including resistive strain sensors and capacitive pressure sensors. In order to prepare the polyampholyte hydrogels, sodium p-styrenesulfonate (NaSS) and (methacryloxyethyl)trimethylammonium chloride (DMC) are used as the anionic and cationic monomers, respectively, and N,N′-methylenebis(acrylamide) (MBAA) is used as the chemical cross-linking agent. The resulting hydrogels, denoted as NaSS/DMC polyampholyte hydrogels, exhibit outstanding self-healing ability, transparency, ionic conductivity, and stretchability. Resistive strain sensors assembled from such polyampholyte hydrogels exhibit a gauge factor (GF) of 2.9 over a strain range of 0–350\%, a low response time of 250 ms, and excellent cycling stability. Moreover, sandwich-structured capacitive pressure sensors are assembled utilizing polyampholyte hydrogels containing reliefs as the electrodes. The pressure sensors achieve a GF of 2.17 kPa–1, a sensing range of 0–7.35 kPa, and high cycling stability. The applications of such wearable mechanosensors in monitoring various strains and pressures in daily life are demonstrated. Overall, this work not only develops a smart hydrogel with outstanding self-healing ability but also provides a clue to construct soft electronics for wearable devices.},
	number = {9},
	urldate = {2026-02-11},
	journal = {ACS Appl. Polym. Mater.},
	publisher = {American Chemical Society},
	author = {Zheng, Huihui and Zhou, Hongwei and Wang, Zhao and Zhang, Shuman and Zhang, Hongli},
	month = sep,
	year = {2023},
	pages = {7581--7589},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/JYE7X5D2/Zheng et al. - 2023 - Ionically Conductive and Self-Healing Polyampholyte Hydrogels for Wearable Resistive Strain Sensors.pdf:application/pdf},
}

@article{panPolyelectrolyteHydrogelVersatile2022,
	title = {Polyelectrolyte hydrogel: {A} versatile platform for mechanical-electric conversion and self-powered sensing},
	volume = {103},
	issn = {2211-2855},
	shorttitle = {Polyelectrolyte hydrogel},
	url = {https://www.sciencedirect.com/science/article/pii/S2211285522007960},
	doi = {10.1016/j.nanoen.2022.107718},
	abstract = {There is an urgent need to develop self-powered technologies for portable strain/pressure sensors. In this work, inspired by salinity-gradient electricity generation, we report the design and fabrication of a mechanical-electric conversion and self-powered sensing platform based on polyelectrolyte hydrogels. Using polyacrylic acid (PAA, whose -COOH group can ionize H+ in water) hydrogel as a model system, we observe that the compression deformation process of the hydrogel leads to a localized increase in the H+ concentration, that induces a directional H+ diffusion as a result of ion concentration difference. In contrast, the PAA chain (negatively charged), as a hydrogel backbone, is hindered from moving freely due to the locking of the hydrogel network. Such drastic difference between ionized H+ and fixed PAA chain defines an opportunity for converting mechanical energy into electricity by compressing the PAA hydrogel. The good elasticity of the PAA hydrogel allows us to repeatedly regenerate and fully recover the electrical signal and finally completes the recycle sensing ({\textgreater}1000 s). PAA hydrogels have also been shown to convert static or low frequency (∼0.05 Hz) pressure (0.05–5 N) to output direct voltage/current. In particular, the hydrogel can yield a voltage output up to ∼6 mV and a current of ∼2 μA when the pressure is 5 N. Taking full advantage of the special sensing principle, we have developed both self-powered and temperature-insensitive PAA hydrogel-based position recognizers and multi-dimensional sound detectors. Importantly, this mechanical-to-electric conversion concept is also applicable to other polyelectrolyte hydrogels. This simple and low-cost soft material system is promising for applications in sensing and energy harvesting.},
	urldate = {2026-02-11},
	journal = {Nano Energy},
	author = {Pan, Xiaofeng and Wang, Qinhua and Benetti, Daniele and Ni, Yonghao and Rosei, Federico},
	month = dec,
	year = {2022},
	keywords = {Mechanical-electric conversion, Polyelectrolyte hydrogels, Polyelectrolyte-gradient, Self-powered sensing},
	pages = {107718},
	file = {ScienceDirect Full Text PDF:/Users/pierrewalker/Zotero/storage/2U9GD2YE/Pan et al. - 2022 - Polyelectrolyte hydrogel A versatile platform for mechanical-electric conversion and self-powered s.pdf:application/pdf;ScienceDirect Snapshot:/Users/pierrewalker/Zotero/storage/SLC6X7DR/S2211285522007960.html:text/html},
}

@article{arsuffiProgrammableMultiResponsiveNanocelluloseBased2024,
	title = {Programmable {Multi}-{Responsive} {Nanocellulose}-{Based} {Hydrogels} {With} {Embodied} {Logic}},
	volume = {34},
	issn = {1616-3028},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/adfm.202409864},
	doi = {10.1002/adfm.202409864},
	abstract = {Programmable materials are desirable for a variety of functional applications that range from biomedical devices, actuators and soft robots to adaptive surfaces and deployable structures. However, current smart materials are often designed to respond to single stimuli (like temperature, humidity, or light). Here, a novel multi-stimuli-responsive composite is fabricated using direct ink writing (DIW) to enable programmability in both space and time and computation of logic operations. The composite hydrogels consist of double-network matrices of poly(N-isopropylacrylamide) (PNIPAM) or poly(acrylic acid) (PAA) and sodium alginate (SA) and are reinforced by a high content of cellulose nanocrystals (CNC) (14 wt\%) and nanofibers (CNF) (1 wt\%). These composites exhibit a simultaneously tunable response to external stimuli, such as temperature, pH, and ion concentration, enabling precise control over their swelling and shrinking behavior, shape, and mechanical properties over time. Bilayer hydrogel actuators are designed to display bidirectional bending in response to various stimuli scenarios. Finally, to leverage the multi-responsiveness and programmability of this new composite, Boolean algebra concepts are used to design and execute NOT, YES, OR, and AND logic gates, paving the way for self-actuating materials with embodied logic.},
	language = {en},
	number = {51},
	urldate = {2026-02-11},
	journal = {Adv. Funct. Mater.},
	author = {Arsuffi, Beatriz and Siqueira, Gilberto and Nyström, Gustav and Titotto, Silvia and Magrini, Tommaso and Daraio, Chiara},
	year = {2024},
	keywords = {4D printing, materials logic, multi-stimuli-responsiveness, nanocellulose hydrogels, programmable materials},
	pages = {2409864},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/DAJSMPFK/Arsuffi et al. - 2024 - Programmable Multi-Responsive Nanocellulose-Based Hydrogels With Embodied Logic.pdf:application/pdf;Snapshot:/Users/pierrewalker/Zotero/storage/Z3QPIJZ2/adfm.html:text/html},
}

