@article{nordnessCharacterizationAqueous1Ethyl3Methylimidazolium2019,
	title = {Characterization of {Aqueous} 1-{Ethyl}-3-{Methylimidazolium} {Ionic} {Liquids} for {Calculation} of {Ion} {Dissociation}},
	volume = {123},
