	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/N2XBGQG6/Fareed and Shityakov - 2025 - Next-Generation Hydrogel Design Computational Advances in Synthesis, Characterization, and Biomedic.pdf:application/pdf},
