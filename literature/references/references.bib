@article{hradetzkyPhaseEquilibriaBinary1991,
	title = {Phase equilibria in binary and higher systems methanol + hydrocarbon(s): {Part} {I}. {Experimental} determination of liquid-liquid equilibrium data and their representation using the {NRTL} equation},
