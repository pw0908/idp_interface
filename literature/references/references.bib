@article{tangEffectNonlinearElasticity2021,
	title = {Effect of {Nonlinear} {Elasticity} on the {Swelling} {Behaviors} of {Highly} {Swollen} {Polyelectrolyte} {Gels}},
	volume = {7},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
	issn = {2310-2861},
	url = {https://www.mdpi.com/2310-2861/7/1/25},
	doi = {10.3390/gels7010025},
	abstract = {Polyelectrolyte gels exhibit swelling behaviors that are dependent on the external environment. The swelling behaviors of highly charged polyelectrolyte gels can be well explained using the Flory–Rehner model combined with the Gibbs–Donnan effect and Manning’s counterion condensation effect (the FRGDM model). This study investigated the swelling properties of a series of model polyelectrolyte gels, namely tetra-polyacrylic acid-polyethylene glycol gels (Tetra-PAA-PEG gels), and determined the applicability of the FRGDM model. The swelling ratio (Vs/V0) was well reproduced by the FRGDM model in the moderate swelling regime (Vs/V0 {\textless} 10). However, in the high swelling regime (Vs/V0 {\textgreater} 10), the FRGDM model is approx. 1.6 times larger than the experimental results. When we introduced the finite extensibility to the elastic free energy in the FRGDM model, the swelling behavior was successfully reproduced even in the high swelling regime. Our results reveal that finite extensibility is one of the factors determining the swelling equilibrium of highly charged polyelectrolyte gels. The modified FRGDM model reproduces well the swelling behavior of a wide range of polyelectrolyte gels.},
	language = {en},
	number = {1},
	urldate = {2026-10-12},
	journal = {Gels},
	publisher = {Multidisciplinary Digital Publishing Institute},
	author = {Tang, Jian and Katashima, Takuya and Li, Xiang and Mitsukami, Yoshiro and Yokoyama, Yuki and Chung, Ung-il and Shibayama, Mitsuhiro and Sakai, Takamasa},
	month = mar,
	year = {2021},
	keywords = {polyelectrolyte, counterion condensation, Gent model, Gibbs–Donnan effect, Neo–Hookean model, nonlinear elasticity, polymer gel, swell},
	pages = {25},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/ANJQTLXV/Tang et al. - 2021 - Effect of Nonlinear Elasticity on the Swelling Behaviors of Highly Swollen Polyelectrolyte Gels.pdf:application/pdf},
}

