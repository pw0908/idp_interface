@article{grossEquationofstateContributionPolar2006,
	title = {An equation-of-state contribution for polar components: {Dipolar} molecules},
	volume = {52},
	issn = {1547-5905},
	shorttitle = {An equation-of-state contribution for polar components},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/aic.10683},
	doi = {10.1002/aic.10683},
	abstract = {Accounting for dipolar interactions in a physically based equation of state (EOS) can substantially improve the modeling of phase equilibria of real mixtures. An EOS contribution for dipolar interactions of nonspherical molecules is developed based on a third-order perturbation theory. Molecular simulation data for vapor–liquid equilibria of the two-center Lennard–Jones (2CLJ) plus pointdipole fluid is used to determine model constants of the EOS. The resulting model is compared to simulation data of pure dipolar nonspherical molecules and their mixtures and an excellent agreement is found. The proposed dipole term is applied to real substances with the perturbed-chain statistical associating fluid theory (PC-SAFT) EOS and it is confirmed that accounting for dipolar interactions not only reduces the binary interaction parameter, but also improves the description of pure component and mixture phase equilibria. Literature values for the dipole moment can thereby be used and no further dipole-related pure component parameter has to be adjusted. This constitutes an advantage over earlier approaches, where dipole-related parameters were fitted to pure component data or to mixture data. © 2005 American Institute of Chemical Engineers AIChE J, 2006},
	number = {3},
	urldate = {2023-04-24},
	journal = {AIChE J.},
	author = {Gross, Joachim and Vrabec, Jadran},
	year = {2006},
	pages = {1194--1204},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/M2EJQDDU/Gross and Vrabec - 2006 - An equation-of-state contribution for polar compon.pdf:application/pdf;Snapshot:/Users/pierrewalker/Zotero/storage/FHWERNQG/aic.html:text/html},
}

@article{zhuMetallopolyelectrolytesClassIonic2018,
	title = {Metallo-polyelectrolytes as a class of ionic macromolecules for functional materials},
	volume = {9},
	copyright = {2018 The Author(s)},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-018-06475-9},
	doi = {10.1038/s41467-018-06475-9},
	abstract = {The fields of soft polymers and macromolecular sciences have enjoyed a unique combination of metals and organic frameworks in the name of metallopolymers or organometallic polymers. When metallopolymers carry charged groups, they form a class of metal-containing polyelectrolytes or metallo-polyelectrolytes. This review identifies the unique properties and functions of metallo-polyelectrolytes compared with conventional organo-polyelectrolytes, in the hope of shedding light on the formation of functional materials with intriguing applications and potential benefits. It concludes with a critical perspective on the challenges and hurdles for metallo-polyelectrolytes, especially experimental quantitative analysis and theoretical modeling of ionic binding.},
	number = {1},
	urldate = {2023-05-03},
	journal = {Nat. Commun.},
	author = {Zhu, Tianyu and Sha, Ye and Yan, Jing and Pageni, Parasmani and Rahman, Md Anisur and Yan, Yi and Tang, Chuanbing},
	month = oct,
	year = {2018},
	keywords = {Polymers, Polymer characterization, Polymer synthesis},
	pages = {4329},
	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/FNN3ISVH/Zhu et al. - 2018 - Metallo-polyelectrolytes as a class of ionic macro.pdf:application/pdf},
}

@article{biesheuvelElectrostaticFreeEnergy2004,
	title = {Electrostatic {Free} {Energy} of {Weakly} {Charged} {Macromolecules} in {Solution} and {Intermacromolecular} {Complexes} {Consisting} of {Oppositely} {Charged} {Polymers}},
	volume = {20},
	issn = {0743-7463},
	url = {https://doi.org/10.1021/la036204l},
	doi = {10.1021/la036204l},
	abstract = {When oppositely charged polyelectrolytes are mixed in water, attraction between oppositely charged groups may lead to the formation of polyelectrolyte complexes (associative phase separation, complex coacervation, interpolymer complexes). Theory is presented to describe the electrostatic free energy change when ionizable (annealed) (macro-)molecules form a macroscopic polyelectrolyte complex. The electrostatic free energy includes an electric term as well as a chemical term that is related to the dissociation of the ionic groups in the polymer. An example calculation for complexation of polyacid with polybase uses a cylindrical diffuse double layer model for free polymer in solution and electroneutrality within the complex and calculates the free energy of the system when the polymer is in solution or in a polyelectrolyte complex. Combined with a term for the nonelectrostatic free energy change upon complexation, a theoretical stability diagram is constructed that relates pH, salt concentration, and mixing ratio, which is in qualitative agreement with an experimental diagram obtained by Bungenberg de Jong (1949) for complex coacervation of arabic gum and gelatin. The theory furthermore explains the increased tendency toward phase separation when the polymer becomes more strongly charged and suggests that complexation of polyacid or polybase with zwitterionic polymer (e.g., protein) of the same charge sign (at the “wrong side” of the iso-electric point) may be due (in part) to an induced charge reversal of the protein.},
	number = {7},
	urldate = {2023-05-03},
	journal = {Langmuir},
	author = {Biesheuvel, P. Maarten and Cohen Stuart, Martien A.},
	month = mar,
	year = {2004},
	pages = {2785--2791},
	file = {ACS Full Text Snapshot:/Users/pierrewalker/Zotero/storage/UP93JVA4/la036204l.html:text/html;Full Text PDF:/Users/pierrewalker/Zotero/storage/WGLZ428N/Biesheuvel and Cohen Stuart - 2004 - Electrostatic Free Energy of Weakly Charged Macrom.pdf:application/pdf},
}

