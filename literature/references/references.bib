	file = {Full Text PDF:/Users/pierrewalker/Zotero/storage/FQCQKDNT/Zhang and Chapman - 2018 - Modeling Thermodynamic Properties of Isomeric Alkanes with a New Branched Equation of State.pdf:application/pdf},
}

@article{stanoTopologyControlledMicrophaseSeparation2025,
	title = {Topology-{Controlled} {Microphase} {Separation} and {Interconversion} of {Twist} and {Writhe} {Domains} in {Supercoiled} {Annealed} {Polyelectrolytes}},
