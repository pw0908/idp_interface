	journal = {J. Chem. Phys.},
	author = {Ghosh, Souradeep and Chowdhury, Aritra and Tomares, Dylan T. and Schuler, Benjamin and Kundagrami, Arindam and Pappu, Rohit V.},
	month = nov,
